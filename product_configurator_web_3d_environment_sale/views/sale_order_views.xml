<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- L'environnement que le montage du devis lit (étape 8.5a), et le bouton qui l'ouvre (8.5b). -->
    <record id="view_order_form_environment" model="ir.ui.view">
        <field name="name">sale.order.form.environment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_montage" type="object" string="Montage" icon="fa-cube"
                        invisible="not environment_id"/>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="environment_id" invisible="not environment_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Au portail : le client rouvre le montage de son devis (8.5b). -->
    <template id="sale_order_portal_montage" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='sale_order_sidebar_button']" position="inside">
            <a t-if="sale_order.environment_id and sale_order.access_token" role="button" class="btn btn-light"
               t-att-href="'/environment/%s' % sale_order.access_token">
                <i class="fa fa-cube me-1"/>Montage
            </a>
        </xpath>
    </template>
</odoo>
