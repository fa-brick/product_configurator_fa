<?xml version="1.0" ?>
<odoo>
    <record id="sale_order_form_config" model="ir.ui.view">
        <field name="name">sale.order.form.config</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <!-- ⓘ **LE BOUTON « Configure Product » A DISPARU** avec la méthode qu'il
                 appelait (arbitrage Gerry, 2026-09-19 : *« pour moi le wizard est
                 mort »*). Le configurateur 3D s'ouvre au CHOIX du produit sur la ligne,
                 ce qui ne demande plus de bouton au-dessus du tableau. -->
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id']"
                position="after"
            >
                <field column_invisible="1" name="config_ok" />
                <field name="config_session_id" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list//field[@name='product_template_id']"
                position="after"
            >
                <field column_invisible="1" name="config_ok" />
                <!-- ⚠️ **LA ROUE DENTÉE A QUITTÉ CETTE VUE**, et pas seulement parce
                     qu'elle était masquée. `reconfigure_product` ne vit plus ici : sa
                     seule implémentation est celle de `product_configurator_web_3d_sale`,
                     qui ouvre la page 3D. Or ce module DÉPEND de celui-ci, donc il charge
                     APRÈS — et une vue qui cite une méthode pas encore définie fait
                     échouer l'installation sur *« reconfigure_product is not a valid
                     action on sale.order.line »*. Une vue ne peut citer que ce que son
                     propre module garantit. -->
                <field name="config_session_id" />
            </xpath>
            <!--
            The line form extension was removed.
            Cases were found where it was causing install errors on other modules,
            that were extending order line (for example sale-workflow/sale_product_approval,
            adding a column after the sales order name field.

            <xpath
                expr="//form//notebook//field[@name='order_line']/form/field[@name='name']"
                position="after"
            >
                <div groups="product_configurator_fa.group_product_configurator_fa">
                    <label for="custom_value_ids" />
                    <field name="custom_value_ids">
                        <tree>
                            <field name="attribute_id" />
                            <field name="name" />
                            <field name="attachment_ids" widget="many2many_tags" />
                        </tree>
                    </field>
                </div>
            </xpath>
            -->
        </field>
    </record>
</odoo>
