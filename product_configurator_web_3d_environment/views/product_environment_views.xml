<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Les produits posés dans les baies d'un environnement (étape 8.4c), sur sa fiche. -->
    <record id="product_environment_view_form_placements" model="ir.ui.view">
        <field name="name">product.environment.form.placements</field>
        <field name="model">product.environment</field>
        <field name="inherit_id" ref="product_editor_environment.product_environment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Placed products" name="placements" invisible="is_template">
                        <field name="placement_ids" readonly="1">
                            <list>
                                <field name="opening_id"/>
                                <field name="product_tmpl_id"/>
                                <field name="session_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
