<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_price_grid_form_view" model="ir.ui.view">
        <field name="name">product.price.grid.form</field>
        <field name="model">product.price.grid</field>
        <field name="arch" type="xml">
            <form string="Price Grid">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="2026 tariff" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_tmpl_id" />
                            <field name="currency_id" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Brackets" name="brackets">
                            <group>
                                <group string="X axis (columns)">
                                    <field name="axis_x_bracket_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="max_value" />
                                            <field name="axis" column_invisible="1" />
                                        </list>
                                    </field>
                                </group>
                                <group string="Y axis (rows)">
                                    <field name="axis_y_bracket_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="max_value" />
                                            <field name="axis" column_invisible="1" />
                                        </list>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page string="Prices" name="prices">
                            <field name="cell_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="grid_id" column_invisible="1" />
                                    <field name="x_bracket_id" />
                                    <field name="y_bracket_id" />
                                    <field name="price" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_price_grid_list_view" model="ir.ui.view">
        <field name="name">product.price.grid.list</field>
        <field name="model">product.price.grid</field>
        <field name="arch" type="xml">
            <list string="Price Grids">
                <field name="name" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="currency_id" />
            </list>
        </field>
    </record>

</odoo>
