<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="product_configurator_web_3d.ConfiguratorPage">
    <!-- ⚠️ LE VIEWER À GAUCHE, LES QUESTIONS À DROITE (arbitrage Gerry, 2026-08-26).
         En colonne sous 900 px : sur un téléphone, la 3D en premier — c'est elle qu'on
         vient voir, et le lien arrive souvent par courriel. -->
    <!-- ⓘ La classe « keyboard » : la page CALÉE AU-DESSUS DU CLAVIER du téléphone (`_watchKeyboard`). -->
    <div class="o_cfg3d_page" t-ref="page"
         t-att-class="{ 'o_cfg3d_page--keyboard': state.keyboard }"
         t-att-style="keyboardStyle">

        <!-- ⚠️ **LA SORTIE — et elle manquait à qui arrive par un LIEN.** La croix ne vivait
             que dans l'overlay de la fiche produit ; la grille de la boutique, un courriel
             et le clic donné trop tôt mènent tous à cette page-ci, où rien ne ramenait au
             produit (relevé de Gerry, 2026-09-22 ; vérifié : zéro croix dans le HTML de
             `/configurator/<jeton>`).

             ⓘ **Un seul endroit décide désormais**, et il sert les deux hôtes : l'overlay
             passe sa fermeture par `onClose`, la page atteinte par navigation retombe sur
             l'URL du produit que l'état porte. Le dialogue du back-office, lui, n'a ni
             l'un ni l'autre — il se ferme par son propre cadre, et n'affiche donc rien. -->
        <button t-if="canClose" class="o_cfg3d_close"
                t-on-click="() => this.onCloseClick()"
                aria-label="Close" title="Close"><i class="oi oi-close" role="img"/></button>

        <div t-if="state.model and state.model.error" class="o_cfg3d_error">
            <p t-esc="state.model.message"/>
        </div>

        <t t-else="">
            <div class="o_cfg3d_viewer">
                <!-- ⚠️ L'ATTENTE A UN VISAGE. Construire un assemblage prend une seconde
                     ou deux : un fond vide laisse croire à une panne. On montre la PHOTO
                     du produit, puis la 3D se pose exactement dessus — c'est la même vue
                     (`is_thumbnail`, D-115), donc le passage ne déplace rien.
                     ⓘ `!` et non `not` : dans un gabarit OWL, `not` est une variable et
                     le composant entier cesse de compiler (L-209). -->
                <div t-if="!state.ready" class="o_cfg3d_loading">
                    <img t-if="state.model and state.model.image"
                         t-att-src="state.model.image" alt=""/>
                    <span class="o_cfg3d_spinner"/>
                </div>
                <!-- ⓘ `cameraApply` reçoit le point de vue de celui qui conduit,
                     `onCameraPose` publie le nôtre quand c'est nous (D-256). Les deux
                     existaient déjà sur le viewer : rien n'a été ajouté à l'éditeur. -->
                <!-- ⚠️ `pieces` ET `sketchItems` : la racine d'un assemblage ne porte
                     presque rien, tout est dans ses enfants — et chaque enfant a besoin
                     de sa POSE, que seul le moteur calcule. `resolvedTreeSerial` dit au
                     viewer que les poses ont changé : il ne relit pas une Map par
                     référence. -->
                <!-- ⚠️ **TROIS PROPS QUI MANQUAIENT** (Gerry, 2026-09-07) :
                     · `getResolvedSolidsByNodeId` — les volumes PERCÉS et CHANFREINÉS
                       du moteur. Sans eux le viewer refait l'extrusion depuis le
                       dessin : la pièce s'affiche, plausible, sans ses trous ;
                     · `rootPieceId` — les zones de matière sont rangées PAR PIÈCE
                       (D-166) ; sans lui la racine reste grise ;
                     · `rootNodeId` — par lui, la racine retrouve son volume construit.
                     ⓘ Aucune de ces absences ne lève : c'est la famille de défauts
                     que seule une capture révèle ([[L-188]]).

                     ⚠️ **`showSketchLines="false"` — AUCUN TRAIT D'ESQUISSE.** Le
                     dessin sert à ÉDITER ; ici on ne peut rien modifier, et ses
                     traits faisaient passer la gravure « JENO » pour un contour
                     rouge posé sur la plaque (Gerry, 2026-09-07). -->
                <!-- ⚠️ **LES DEUX MOITIÉS D'UN MÊME GESTE, et elles ne valent que POSÉES
                     ENSEMBLE** : `onSelectPiece` est ce que le viewer publie au clic comme
                     à la tape, `selectedSketchId` la seule chose qui allume son contour de
                     SÉLECTION. N'en passer qu'une laisse la boucle ouverte — l'état d'avant
                     le 2026-09-22, où le contour cyan n'était allumé nulle part et où seul
                     le SURVOL peignait, donc jamais au doigt (Gerry). -->
                <!-- ⓘ Isolée : pas de bouton « voir tout » — la flèche de l'en-tête du
                     panneau ramène à la racine (Gerry, 2026-09-23). -->
                <!-- ⚠️ LA SÉLECTION (D-333) : `pieces` est le sous-arbre isolé ou tout ;
                     `selectableNodeIds` dit au viewer ce qu'un clic peut désigner — et ce
                     qu'un survol CONTOURE en orange, comme dans l'éditeur, sans nom
                     (arbitrage Gerry, 2026-09-23) ; `selectedNodeIds` allume le contour de
                     sélection ; les deux rappels remontent clic et double clic. -->
                <PartViewer3D sketchItems="viewerSketchItems"
                              pieces="viewerPieces"
                              selectedNodeIds="selectedNodeIds"
                              selectableNodeIds="selectableNodeIds"
                              onSelectPiece.bind="onSelectPiece"
                              onActivatePiece.bind="onActivatePiece"
                              resolvedTreeSerial="state.sceneSerial"
                              getResolvedWorldByNodeId.bind="getResolvedWorldByNodeId"
                              getResolvedSolidsByNodeId.bind="getResolvedSolidsByNodeId"
                              getResolvedBakedSolids.bind="getResolvedBakedSolids"
                              engravingsByPiece="state.postBuild.byPiece"
                              engravingsByNode="state.postBuild.byNode"
                              perforationsByPiece="state.postBuild.perforations"
                              rootPieceId="rootPieceId"
                              rootNodeId="rootNodeId"
                              onSelectSketch="() => {}"
                              onSelectPiece="(id) => this.onSelectPiece(id)"
                              displayMode="'realistic'"
                              ambience="ambience"
                              showPlanes="false"
                              origineVisible="false"
                              hideViewGizmo="true"
                              showSketchLines="false"
                              zonesByPiece="zonesByPiece"
                              zoneMaterialsByNode="zoneMaterialsByNode"
                              cameraApply="state.cameraApply"
                              viewInsetTop="state.viewInsetTop"
                              onCameraPose="(pose) => this.onCameraPose(pose)"/>

                <!-- ⓘ LES ÉTAPES (D-385) — des pastilles en haut du viewer, centrées sur
                     sa largeur (demande de Gerry, 2026-09-30). Une pastille GRISÉE reste
                     cliquable : elle dit ce qui manque et y mène (`onStepChip`), comme une
                     valeur éteinte dit pourquoi (D-178). ⚠️ `aria-disabled` et non
                     `disabled` : un bouton désactivé ne reçoit plus le clic. -->
                <!-- ⓘ SUR TÉLÉPHONE, LA BARRE D'ACTION MONTE SUR LA 3D (D-389) — en haut, la
                     croix à sa droite (Gerry, 2026-10-01) : le pied de la colonne disparaît, et
                     c'est autant de hauteur rendue à la 3D. Les étapes passent sous elle. -->
                <div t-if="state.compact" class="o_cfg3d_topbar">
                    <t t-call="product_configurator_web_3d.ActionBar"/>
                </div>

                <nav t-if="stepChips.length" class="o_cfg3d_steps" t-att-aria-label="stepsLabel">
                    <t t-foreach="stepChips" t-as="chip" t-key="chip.id">
                        <button type="button" class="o_cfg3d_panel_chip o_cfg3d_step_chip"
                                t-att-class="{ 'o_cfg3d_panel_chip--on': chip.active,
                                               'o_cfg3d_step_chip--locked': chip.locked }"
                                t-att-aria-current="chip.active ? 'step' : false"
                                t-att-aria-disabled="chip.locked ? 'true' : false"
                                t-on-click="() => this.onStepChip(chip)"
                                t-esc="chip.name"/>
                    </t>
                </nav>
            </div>

            <!-- ⓘ La marque `o_cfg3d_side` + `panel` : sur téléphone, la colonne GRANDIT le temps du panneau de choix,
                 et la 3D rétrécit au-dessus au lieu d'être couverte (D-389). -->
            <aside class="o_cfg3d_side" t-att-class="{ 'o_cfg3d_side--panel': panelQuestion }">
                <!-- ⓘ SEUL LE CORPS DÉFILE. Le titre et le pied restent en place : ce
                     qu'on vient chercher — le prix et le geste — ne doit jamais partir
                     hors de l'écran (demande de Gerry, 2026-09-06). -->
                <div class="o_cfg3d_scroll" t-ref="answers">
                <!-- ⓘ L'EN-TÊTE dit où l'on est : le produit, ou — une pièce sélectionnée —
                     la FLÈCHE de retour suivie du nom de la pièce (maquette de Gerry,
                     2026-09-23). Pas de fil d'Ariane, pas de bouton en bas : la flèche est
                     le seul retour, et la croix reste celle de la page. Flèche et croix sont
                     les icônes Odoo (`oi`, traits fins) que les bundles servent déjà (Gerry,
                     2026-09-23) — pas de SVG à nous. -->
                <h1 t-if="selectedPlacement" class="o_cfg3d_title o_cfg3d_title--piece">
                    <button class="o_cfg3d_backarrow"
                            t-on-click="() => this.onClearSelection()"
                            t-att-title="backToProductLabel" t-att-aria-label="backToProductLabel">
                        <i class="oi oi-arrow-left" role="img"/>
                    </button>
                    <span t-esc="selectedPlacement.label"/>
                </h1>
                <h1 t-else="" class="o_cfg3d_title" t-esc="state.model and state.model.productName"/>

                <div t-if="state.model and state.model.closed" class="o_cfg3d_closed"
                     t-esc="closedLabel"/>

                <!-- ⚠️ QUI CONDUIT — et le moyen de le remplacer, au même endroit.
                     Un bandeau qui annonce un empêchement sans offrir la sortie
                     laisse le lecteur devant une porte fermée. -->
                <div t-if="watching" class="o_cfg3d_hand">
                    <span t-esc="handLabel"/>
                    <button class="btn btn-sm btn-primary"
                            t-att-disabled="state.loading"
                            t-on-click="() => this.onTakeHand()"
                            t-esc="takeHandLabel"/>
                </div>

                <!-- ── LA PIÈCE SÉLECTIONNÉE — ses questions, à la place de celles du produit
                     (D-333 : « en un clic, éditer ses questions »). Le retour est la flèche
                     de l'en-tête, ci-dessus. -->
                <section t-if="selectedPlacement and !state.compact" class="o_cfg3d_piece">
                    <t t-foreach="selectedPlacement.questions" t-as="question" t-key="question.id">
                        <t t-call="product_configurator_web_3d.Question">
                            <t t-set="placementNodeId" t-value="state.selection.nodeId"/>
                        </t>
                    </t>
                </section>

                <!-- ⓘ Les questions du PRODUIT — par le MÊME gabarit qu'une pièce. -->
                <!-- ⓘ Celles de l'ÉTAPE affichée — toutes, sans étape (D-385). -->
                <t t-if="!selectedPlacement and !state.compact">
                    <t t-foreach="shownQuestions" t-as="question" t-key="question.id">
                        <t t-call="product_configurator_web_3d.Question">
                            <t t-set="placementNodeId" t-value="null"/>
                        </t>
                    </t>
                </t>

                <!-- ⓘ SUR TÉLÉPHONE, LES QUESTIONS EN ONGLETS (D-389) — celles de l'étape, ou
                     de la pièce sélectionnée, en une rangée qui défile ; l'onglet ouvert est
                     CENTRÉ (`_settleTabs`) pour montrer qu'il y en a d'autres de chaque côté, et
                     seul son champ s'affiche dessous (Gerry, 2026-10-01). La pastille d'un onglet
                     dit qu'une réponse obligatoire y manque : on ne voit plus qu'une question à
                     la fois. -->
                <t t-if="state.compact and activeQuestion">
                    <div class="o_cfg3d_tabs" role="tablist" t-ref="tabs"
                         t-att-data-active="activeQuestion.id">
                        <t t-foreach="tabQuestions" t-as="tab" t-key="tab.id">
                            <button type="button" role="tab" class="o_cfg3d_tab"
                                    t-att-class="{ 'o_cfg3d_tab--on': tab.id === activeQuestion.id }"
                                    t-att-aria-selected="tab.id === activeQuestion.id ? 'true' : 'false'"
                                    t-on-click="() => this.onTab(tab)">
                                <span t-esc="tab.name"/>
                                <span t-if="tab.missing" class="o_cfg3d_tab_missing"
                                      t-att-title="missingLabel" t-att-aria-label="missingLabel"/>
                            </button>
                        </t>
                    </div>
                    <!-- ⓘ La boîte du champ prend la hauteur de son contenu, bornée : pas de blanc
                         sous un champ court (Gerry, 2026-10-01). -->
                    <div class="o_cfg3d_field" role="tabpanel">
                        <t t-set="question" t-value="activeQuestion"/>
                        <t t-call="product_configurator_web_3d.Question">
                            <t t-set="placementNodeId"
                               t-value="selectedPlacement ? state.selection.nodeId : null"/>
                        </t>
                        <p t-if="state.reason" class="o_cfg3d_reason" t-esc="state.reason"/>
                    </div>
                </t>

                <p t-if="!questions.length and !state.loading and !selectedPlacement" class="o_cfg3d_note"
                   t-esc="emptyLabel"/>

                <!-- La raison d'un refus, là où le doigt vient de se poser. -->
                <p t-if="state.reason and !state.compact" class="o_cfg3d_reason" t-esc="state.reason"/>

                </div>

                <!-- ⓘ LA BARRE D'ACTION (D-389) — un gabarit nommé, pour que le mode compact la
                     pose en haut du viewer sans la dupliquer. -->
                <div t-if="!state.compact" class="o_cfg3d_footer">
                    <t t-call="product_configurator_web_3d.ActionBar"/>
                </div>

                <!-- ⓘ LE PANNEAU DE CHOIX (D-382) — par-dessus la colonne, qui le borne ; sur
                     téléphone, la colonne grandit pour lui (D-389). Relu à chaque rendu :
                     `panelQuestion`. -->
                <t t-if="panelQuestion" t-call="product_configurator_web_3d.AnswerPanel"/>
            </aside>
        </t>
    </div>
</t>

<!-- ⓘ LA BARRE D'ACTION (D-389) — le prix et le geste qui termine, sur UNE ligne (Gerry,
     2026-10-01). ⓘ Pas de composant à emplacement : un gabarit nommé, appelé par `t-call`
     hors de toute boucle ([[L-453]]). -->
<t t-name="product_configurator_web_3d.ActionBar">
    <div class="o_cfg3d_actionbar">
        <div class="o_cfg3d_price">
            <span class="o_cfg3d_price_label" t-esc="priceLabel"/>
            <strong class="o_cfg3d_price_amount" t-esc="price"/>
        </div>
        <!-- ⓘ LE PANIER POUR TOUS LES HÔTES, en icône seule : celle d'Odoo
             (`website_sale`, `fa fa-shopping-cart`), arbitrage de Gerry (2026-10-01). Ce que
             fait le bouton ne change pas, et son NOM le dit : un bouton fait d'une seule
             icône n'en a que par `title` et `aria-label`.
             Le bouton DISPARAÎT une fois la configuration close : le bandeau de fermeture,
             plus haut, dit alors ce qu'il en est. Deux états, un seul endroit qui parle.
             ⚠️ `!` ET NON `not` : OWL en ferait une VARIABLE, et la page entière resterait
             BLANCHE (L-209). -->
        <button t-if="state.model and !state.model.closed and !state.model.error"
                type="button"
                class="btn btn-primary o_cfg3d_confirm"
                t-att-disabled="state.loading or watching"
                t-att-title="confirmLabel" t-att-aria-label="confirmLabel"
                t-on-click="() => this.onConfirm()">
            <i class="fa fa-shopping-cart" role="img"/>
        </button>
    </div>
</t>

<!-- ⓘ UNE QUESTION — de la racine (`placementNodeId` nul) ou d'un placement sélectionné
     (D-333). Un seul gabarit : ce qui change est le lien qui part avec la réponse,
     jamais la forme. ⚠️ Un gabarit NOMMÉ, appelé de l'autre — pas un auto-appel ([[L-027]]). -->
<t t-name="product_configurator_web_3d.Question">
    <!-- ⓘ `data-question-id` : c'est par lui qu'une réponse MANQUANTE est retrouvée,
         amenée sous les yeux et reçoit le focus (D-385, `_revealQuestion`). -->
    <section class="o_cfg3d_question" t-att-data-question-id="question.id">
        <!-- ⓘ La LIGNE RÉSUMÉ porte le nom de la question dans son cadre (D-382) : il ne
             se répète pas au-dessus. Une saisie libre garde son titre. -->
        <!-- ⓘ En mode compact, l'ONGLET porte déjà le nom (D-389). -->
        <h2 t-if="!state.compact and (question.free or question.answerLayout !== 'summary')"
            t-esc="question.name"/>
        <!-- ⚠️ **LA QUESTION PREND LA FORME QU'ON LUI A DONNÉE.**
             `display_type` est réglé en back-office depuis toujours ;
             la page l'ignorait et rendait un bouton pour tout
             (constat de Gerry, 2026-09-06). Cinq formes viennent
             d'Odoo, la sixième — la CARTE — a été ajoutée pour les
             réponses qui désignent un produit ou une matière : on
             reconnaît une pièce à sa forme avant de lire son nom.

             ⓘ Le geste, lui, ne change JAMAIS : `onPick`. Ce qui
             change est ce que l'œil reçoit. -->

        <!-- ── LA SAISIE LIBRE (D-353) : la question qui autorise l'ajout ──
             ⚠️ **ELLE PASSE AVANT LA FORME D'AFFICHAGE**, et ce n'en est pas une de
             plus : une forme inconnue disparaît sans erreur des pages d'Odoo (lot C
             abandonné, 2026-09-08). Le discriminant est l'AJOUT, lu sur la ligne ; la
             liste de la question devient la liste des SUGGESTIONS.
             ⓘ Un nombre appelle le pavé numérique (`inputmode="decimal"`), jamais un
             `type="number"`, qui mange la virgule ([[L-218]]).
             ⚠️ **UN NOMBRE N'A PAS DE LISTE** (Gerry, 2026-10-05) : la question autorise
             l'ajout, les valeurs existantes ne sont qu'une partie des réponses possibles.
             Un champ nu, sans la déroulante d'`AutoComplete` — elle se posait sur les
             onglets, et sur Android le pavé se refermait dès la frappe ([[L-504]]). -->
        <t t-if="question.free">
            <div class="o_cfg3d_free">
                <input t-if="question.free.numeric" type="text" inputmode="decimal"
                       class="o_cfg3d_free_input" autocomplete="off"
                       t-att-value="this.freeText(question)"
                       t-on-change="(ev) => this.onFreeChange(placementNodeId, question, ev.target.value)"/>
                <AutoComplete t-else=""
                    value="this.freeText(question)"
                    sources="this.freeSources(question)"
                    onSelect="(option) => this.onFreeSelect(placementNodeId, question, option)"
                    onChange="(ev) => this.onFreeChange(placementNodeId, question, ev.inputValue)"/>
                <span t-if="question.free.unit" class="o_cfg3d_free_unit"
                      t-esc="question.free.unit"/>
            </div>
            <div t-if="this.freeBounds(question)" class="o_cfg3d_free_hint"
                 t-esc="this.freeBounds(question)"/>
        </t>

        <!-- ── LA LIGNE RÉSUMÉ (D-382) : la question, ce qui est choisi, et le panneau au
             clic. Pour les formes à image, les boutons et la liste (Gerry, 2026-09-30).
             ⓘ La vignette n'apparaît que si le choix en a une : pas de cadre vide. Ronde pour
             une pastille ou une teinte seule, carrée pour l'image d'un produit, qu'un disque
             rognerait. -->
        <button t-elif="question.answerLayout === 'summary'" type="button" class="o_cfg3d_summary"
                t-on-click="() => this.openPanel(placementNodeId, question)">
            <t t-set="picked" t-value="this.pickedAnswer(question)"/>
            <span t-if="picked and (picked.image or picked.color)" class="o_cfg3d_summary_shot"
                  t-att-class="{ 'o_cfg3d_summary_shot--disc': question.displayType === 'swatch' or !picked.image }"
                  t-att-style="picked.color ? 'background-color: ' + picked.color : ''">
                <img t-if="picked.image" t-att-src="picked.image" t-att-alt="picked.name"/>
            </span>
            <span class="o_cfg3d_summary_text">
                <span class="o_cfg3d_summary_question" t-esc="question.name"/>
                <span class="o_cfg3d_summary_answer"
                      t-att-class="{ 'o_cfg3d_summary_answer--empty': !picked }"
                      t-esc="picked ? picked.name : chooseLabel"/>
            </span>
            <i class="oi oi-chevron-right o_cfg3d_summary_chevron" role="img"/>
        </button>

        <!-- ── LA CARTE : une vignette, son libellé dessous ── -->
        <!-- ⓘ L'enveloppe `o_cfg3d_scrollrow` est inerte en disposition `inline` ; en
             `scroll`, la grille, son PREMIER enfant, devient une rangée qui défile (D-382). -->
        <t t-elif="question.displayType === 'card'">
            <t t-set="shown" t-value="this.shownAnswers(question)"/>
            <div class="o_cfg3d_scrollrow"
                 t-att-class="{ 'o_cfg3d_scrollrow--active': this.layoutOn(question) === 'scroll' }"
                 t-att-data-chosen="this.chosenKey(question)"
                 t-on-scroll.capture="onRowScroll"
                 t-on-mouseenter="onRowScroll">
                <div class="o_cfg3d_cards"
                     t-att-class="'o_cfg3d_cards--' + question.answerSize">
                    <t t-foreach="shown.values" t-as="value" t-key="value.id">
                        <t t-call="product_configurator_web_3d.Card"/>
                    </t>
                    <!-- « +N / Tout voir » : la dernière case d'une ligne pleine (D-382). -->
                    <button t-if="shown.more" type="button" class="o_cfg3d_card o_cfg3d_card--more"
                            t-on-click="() => this.openPanel(placementNodeId, question)">
                        <span class="o_cfg3d_card_shot o_cfg3d_more">+<t t-esc="shown.more"/></span>
                        <span class="o_cfg3d_card_label" t-esc="seeAllLabel"/>
                    </button>
                </div>
                <t t-if="this.layoutOn(question) === 'scroll'" t-call="product_configurator_web_3d.ScrollArrows"/>
            </div>
        </t>

        <!-- ── LA COULEUR : la pastille, et le nom au survol ── -->
        <!-- ── LA GRANDE PASTILLE : un disque illustré, son nom dessous ──
             ⓘ Demande de Gerry (2026-09-29) : la « Couleur » est trop petite pour montrer
             une texture, et le choix doit se VOIR — coche au centre, anneau à la couleur
             du thème, nom en gras. ⚠️ La coche OU l'anneau, jamais les deux (Gerry) : la
             marque se règle sur l'attribut (`swatchMark`). L'anneau est une OMBRE, dans la
             marge que la grille réserve : un contour déborde, et un cadre qui défile le
             rogne. -->
        <t t-elif="question.displayType === 'swatch'">
            <t t-set="shown" t-value="this.shownAnswers(question)"/>
            <div class="o_cfg3d_scrollrow"
                 t-att-class="{ 'o_cfg3d_scrollrow--active': this.layoutOn(question) === 'scroll' }"
                 t-att-data-chosen="this.chosenKey(question)"
                 t-on-scroll.capture="onRowScroll"
                 t-on-mouseenter="onRowScroll">
                <div class="o_cfg3d_bigswatches"
                     t-att-class="'o_cfg3d_bigswatches--' + question.swatchMark + ' o_cfg3d_bigswatches--' + question.answerSize">
                    <t t-foreach="shown.values" t-as="value" t-key="value.id">
                        <t t-call="product_configurator_web_3d.BigSwatch"/>
                    </t>
                    <button t-if="shown.more" type="button" class="o_cfg3d_bigswatch o_cfg3d_bigswatch--more"
                            t-on-click="() => this.openPanel(placementNodeId, question)">
                        <span class="o_cfg3d_bigswatch_disc o_cfg3d_more">+<t t-esc="shown.more"/></span>
                        <span class="o_cfg3d_bigswatch_label" t-esc="seeAllLabel"/>
                    </button>
                </div>
                <t t-if="this.layoutOn(question) === 'scroll'" t-call="product_configurator_web_3d.ScrollArrows"/>
            </div>
        </t>

        <div t-elif="question.displayType === 'color'"
             class="o_cfg3d_swatches">
            <t t-foreach="question.values" t-as="value" t-key="value.id">
                <button class="o_cfg3d_swatch"
                        t-att-class="{
                            'o_cfg3d_swatch--chosen': value.chosen,
                            'o_cfg3d_swatch--muted': value.muted }"
                        t-att-title="value.name"
                        t-att-style="value.color ? 'background-color: ' + value.color : ''"
                        t-on-click="() => this.onAnswer(placementNodeId, question.id, value)">
                    <img t-if="value.image" t-att-src="value.image"
                         t-att-alt="value.name"/>
                </button>
            </t>
        </div>

        <!-- ── LA LISTE : pour les questions à longue réponse ── -->
        <select t-elif="question.displayType === 'select'"
                class="o_cfg3d_select form-select"
                t-on-change="(ev) => this.onAnswerSelect(placementNodeId, question, ev)">
            <!-- ⚠️ Sans cette ligne vide, un menu deroulant montre sa
                 PREMIERE valeur comme si elle etait choisie : la
                 question parait repondue alors qu'elle ne l'est pas. -->
            <option value="" t-att-selected="!this.isAnswered(question)">
                <t t-esc="chooseLabel"/>
            </option>
            <t t-foreach="question.values" t-as="value" t-key="value.id">
                <option t-att-value="value.id"
                        t-att-selected="value.chosen"
                        t-esc="value.name"/>
            </t>
        </select>

        <!-- ── LES CASES : une question qui accepte PLUSIEURS
             réponses. ⚠️ C'est la seule forme dont la règle
             SERVEUR diffère : répondre AJOUTE au lieu de
             remplacer. -->
        <div t-elif="question.displayType === 'multi'"
             class="o_cfg3d_checks">
            <t t-foreach="question.values" t-as="value" t-key="value.id">
                <label class="o_cfg3d_check"
                       t-att-class="{ 'o_cfg3d_check--muted': value.muted }">
                    <input type="checkbox" t-att-checked="value.chosen"
                           t-on-change="() => this.onAnswer(placementNodeId, question.id, value)"/>
                    <span t-esc="value.name"/>
                </label>
            </t>
        </div>

        <!-- ── RADIO ET PASTILLES : la forme d'origine ── -->
        <div t-else="" class="o_cfg3d_values">
            <t t-foreach="question.values" t-as="value" t-key="value.id">
                <!-- ⚠️ Une valeur ÉTEINTE reste un bouton : c'est D-178,
                     un appui doit pouvoir en donner la raison. `disabled`
                     interdirait l'appui, donc la raison. -->
                <button class="o_cfg3d_value"
                        t-att-class="{
                            'o_cfg3d_value--chosen': value.chosen,
                            'o_cfg3d_value--muted': value.muted }"
                        t-on-click="() => this.onAnswer(placementNodeId, question.id, value)">
                    <span t-esc="value.name"/>
                </button>
            </t>
        </div>
    </section>
</t>

<!-- ⓘ UNE CARTE — dans la question comme dans le panneau (D-382). Reçoit `value`,
     `question` et `placementNodeId` du gabarit qui l'appelle, par `t-call` : pas de
     composant à emplacement ici ([[L-453]]). -->
<t t-name="product_configurator_web_3d.Card">
    <button class="o_cfg3d_card"
            t-att-class="{
                'o_cfg3d_card--chosen': value.chosen,
                'o_cfg3d_card--muted': value.muted }"
            t-on-click="() => this.onAnswer(placementNodeId, question.id, value)">
        <!-- ⚠️ **PAS DE CADRE SANS IMAGE.** Une vignette promise et vide est pire qu'une
             absence : elle se lit comme un chargement en panne. Une valeur qui ne désigne
             rien n'a pas d'image, et la carte se réduit alors à son libellé (relevé de
             Gerry, 2026-09-07). -->
        <span t-if="value.image" class="o_cfg3d_card_shot">
            <img t-att-src="value.image" t-att-alt="value.name" loading="lazy"/>
        </span>
        <span class="o_cfg3d_card_label" t-esc="value.name"/>
    </button>
</t>

<!-- ⓘ UNE GRANDE PASTILLE — même principe que la carte. -->
<t t-name="product_configurator_web_3d.BigSwatch">
    <button class="o_cfg3d_bigswatch"
            t-att-class="{
                'o_cfg3d_bigswatch--chosen': value.chosen,
                'o_cfg3d_bigswatch--muted': value.muted }"
            t-att-title="value.name"
            t-on-click="() => this.onAnswer(placementNodeId, question.id, value)">
        <span class="o_cfg3d_bigswatch_disc"
              t-att-style="value.color ? 'background-color: ' + value.color : ''">
            <img t-if="value.image" t-att-src="value.image" t-att-alt="value.name" loading="lazy"/>
            <span t-if="value.chosen and question.swatchMark === 'check'"
                  class="o_cfg3d_bigswatch_check">
                <i class="fa fa-check"/>
            </span>
        </span>
        <span class="o_cfg3d_bigswatch_label" t-esc="value.name"/>
    </button>
</t>

<!-- ⓘ LE PANNEAU DE CHOIX (D-382) — toutes les réponses d'une question, une recherche, une
     vue. Il reste ouvert jusqu'à « Retour », choix simple compris (Gerry, 2026-09-30) : ce
     qu'on choisit se voit dans la 3D, à côté, sans le quitter.
     ⚠️ La RAISON d'un refus (D-178) s'affiche ICI : celle de la colonne est dessous. -->
<t t-name="product_configurator_web_3d.AnswerPanel">
    <t t-set="question" t-value="panelQuestion"/>
    <t t-set="placementNodeId" t-value="state.panel.nodeId"/>
    <section class="o_cfg3d_panel" role="dialog" t-att-aria-label="question.name">
        <!-- ⓘ LA POIGNÉE (D-389, téléphone) — comme la page de Roomle : elle ferme, comme
             « Retour » et comme une tape dans la 3D. -->
        <button t-if="state.compact" type="button" class="o_cfg3d_panel_grip"
                t-att-title="closeLabel" t-att-aria-label="closeLabel"
                t-on-click="() => this.closePanel()">
            <i class="oi oi-chevron-down" role="img"/>
        </button>
        <!-- ⓘ LA FLÈCHE, PUIS LE NOM DE LA QUESTION, SUR UNE LIGNE (Gerry, 2026-10-01) — comme
             l'en-tête d'une pièce sélectionnée (D-333). La flèche est le retour ; « Retour »
             écrit ne reste que dans son nom (`title`, `aria-label`). -->
        <header class="o_cfg3d_panel_head">
            <h2 class="o_cfg3d_panel_title">
                <button type="button" class="o_cfg3d_panel_back"
                        t-att-title="backLabel" t-att-aria-label="backLabel"
                        t-on-click="() => this.closePanel()">
                    <i class="oi oi-arrow-left" role="img"/>
                </button>
                <span t-esc="question.name"/>
            </h2>
        </header>
        <div class="o_cfg3d_panel_tools">
            <div class="o_cfg3d_panel_search">
                <input type="search" class="o_cfg3d_panel_input" t-ref="panelSearch"
                       t-att-placeholder="searchLabel" t-att-aria-label="searchLabel"
                       t-att-value="state.panel.search"
                       t-on-input="(ev) => this.onPanelSearch(ev)"/>
                <i class="oi oi-search" role="img"/>
            </div>
            <div t-if="this.isImageForm(question)" class="o_cfg3d_panel_views" role="group">
                <button type="button" class="o_cfg3d_panel_view"
                        t-att-class="{ 'o_cfg3d_panel_view--on': state.panel.view === 'list' }"
                        t-att-aria-pressed="state.panel.view === 'list' ? 'true' : 'false'"
                        t-att-title="listViewLabel" t-att-aria-label="listViewLabel"
                        t-on-click="() => this.onPanelView('list')">
                    <i class="fa fa-list"/>
                </button>
                <button type="button" class="o_cfg3d_panel_view"
                        t-att-class="{ 'o_cfg3d_panel_view--on': state.panel.view === 'small' }"
                        t-att-aria-pressed="state.panel.view === 'small' ? 'true' : 'false'"
                        t-att-title="smallViewLabel" t-att-aria-label="smallViewLabel"
                        t-on-click="() => this.onPanelView('small')">
                    <i class="fa fa-th"/>
                </button>
                <button type="button" class="o_cfg3d_panel_view"
                        t-att-class="{ 'o_cfg3d_panel_view--on': state.panel.view === 'large' }"
                        t-att-aria-pressed="state.panel.view === 'large' ? 'true' : 'false'"
                        t-att-title="largeViewLabel" t-att-aria-label="largeViewLabel"
                        t-on-click="() => this.onPanelView('large')">
                    <i class="fa fa-th-large"/>
                </button>
            </div>
        </div>
        <!-- LES PASTILLES DE CATÉGORIES (D-382) : sous la recherche, elles filtrent — « Tout »
             d'abord, « Autres » en dernier ; aucune sous deux groupes. -->
        <t t-set="chips" t-value="this.panelChips(question)"/>
        <div t-if="chips.length" class="o_cfg3d_panel_chips" role="group">
            <t t-foreach="chips" t-as="chip" t-key="chip.key or 'all'">
                <button type="button" class="o_cfg3d_panel_chip"
                        t-att-class="{ 'o_cfg3d_panel_chip--on': state.panel.category === chip.key }"
                        t-att-aria-pressed="state.panel.category === chip.key ? 'true' : 'false'"
                        t-on-click="() => this.onPanelCategory(chip.key)"
                        t-esc="chip.label"/>
            </t>
        </div>
        <p t-if="state.reason" class="o_cfg3d_reason o_cfg3d_panel_reason" t-esc="state.reason"/>
        <div class="o_cfg3d_panel_body">
            <t t-set="found" t-value="this.panelValues(question)"/>
            <p t-if="!found.length" class="o_cfg3d_note" t-esc="noMatchLabel"/>
            <!-- La LISTE : une vignette si la réponse en a une, son nom, la coche. -->
            <div t-elif="state.panel.view === 'list'" class="o_cfg3d_panel_list">
                <t t-foreach="found" t-as="value" t-key="value.id">
                    <button type="button" class="o_cfg3d_panel_row"
                            t-att-class="{
                                'o_cfg3d_panel_row--chosen': value.chosen,
                                'o_cfg3d_panel_row--muted': value.muted }"
                            t-on-click="() => this.onAnswer(placementNodeId, question.id, value)">
                        <span t-if="value.image or value.color" class="o_cfg3d_panel_shot"
                              t-att-class="{ 'o_cfg3d_panel_shot--disc': question.displayType === 'swatch' or !value.image }"
                              t-att-style="value.color ? 'background-color: ' + value.color : ''">
                            <img t-if="value.image" t-att-src="value.image" t-att-alt="value.name" loading="lazy"/>
                        </span>
                        <span class="o_cfg3d_panel_name" t-esc="value.name"/>
                        <i t-if="value.chosen" class="fa fa-check o_cfg3d_panel_check"/>
                    </button>
                </t>
            </div>
            <div t-elif="question.displayType === 'card'" class="o_cfg3d_cards"
                 t-att-class="'o_cfg3d_cards--' + state.panel.view">
                <t t-foreach="found" t-as="value" t-key="value.id">
                    <t t-call="product_configurator_web_3d.Card"/>
                </t>
            </div>
            <div t-else="" class="o_cfg3d_bigswatches"
                 t-att-class="'o_cfg3d_bigswatches--' + question.swatchMark + ' o_cfg3d_bigswatches--' + state.panel.view">
                <t t-foreach="found" t-as="value" t-key="value.id">
                    <t t-call="product_configurator_web_3d.BigSwatch"/>
                </t>
            </div>
        </div>
    </section>
</t>

<!-- ⓘ LES FLÈCHES D'UNE RANGÉE QUI DÉFILE (D-382) — pour la souris ; la feuille de style
     les cache au doigt et au bord atteint. -->
<t t-name="product_configurator_web_3d.ScrollArrows">
    <button type="button" class="o_cfg3d_scrollrow_arrow o_cfg3d_scrollrow_arrow--prev"
            aria-label="Previous" title="Previous"
            t-on-click="(ev) => this.onRowArrow(ev, -1)">
        <i class="fa fa-chevron-left"/>
    </button>
    <button type="button" class="o_cfg3d_scrollrow_arrow o_cfg3d_scrollrow_arrow--next"
            aria-label="Next" title="Next"
            t-on-click="(ev) => this.onRowArrow(ev, 1)">
        <i class="fa fa-chevron-right"/>
    </button>
</t>
</templates>
