<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_attribute_line_form_view_3d" model="ir.ui.view">
        <field name="name">product.template.attribute.line.form.view3d</field>
        <field name="model">product.template.attribute.line</field>
        <field
            name="inherit_id"
            ref="product_configurator_fa.product_template_attribute_line_form_config"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='configurator_pricing']" position="inside">
                <field name="view_camera_id" />
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_3d" model="ir.ui.view">
        <field name="name">product.template.form.view3d</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_configurator_fa.product_template_only_form_view_inherited" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='config_step_line_ids']/list/field[@name='visibility_domain_id']"
                position="after"
            >
                <field name="view_camera_id" />
            </xpath>
        </field>
    </record>

</odoo>
