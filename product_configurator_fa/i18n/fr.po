#. module: product_configurator_fa
#: model:ir.model.fields,field_description:product_configurator_fa.field_product_attribute__unavailable_display
#: model:ir.model.fields,field_description:product_configurator_fa.field_product_template_attribute_line__unavailable_display
msgid "Unavailable values"
msgstr "Valeurs indisponibles"

#. module: product_configurator_fa
#: model:ir.model.fields,help:product_configurator_fa.field_product_attribute__unavailable_display
msgid ""
"What the configurator does with a value that the current choices rule out. "
"Greyed out: it stays visible, and a tap says why. Hidden: it is not shown at"
" all. A product line can override this setting."
msgstr ""
"Ce que le configurateur fait d'une valeur que les choix en cours écartent. "
"Grisées : elle reste visible, et un appui dit pourquoi. Masquées : elle "
"n'est pas montrée du tout. La ligne d'un produit peut surcharger ce réglage."

#. module: product_configurator_fa
#: model:ir.model.fields,help:product_configurator_fa.field_product_template_attribute_line__unavailable_display
msgid ""
"Overrides the attribute's setting for this product only. Empty: the "
"attribute's setting applies."
msgstr ""
"Surcharge le réglage de l'attribut pour ce produit seulement. Vide : le "
"réglage de l'attribut s'applique."

#. module: product_configurator_fa
#: model:ir.model.fields.selection,name:product_configurator_fa.selection__product_attribute__unavailable_display__grey
#: model:ir.model.fields.selection,name:product_configurator_fa.selection__product_template_attribute_line__unavailable_display__grey
msgid "Greyed out"
msgstr "Grisées"

#. module: product_configurator_fa
#: model:ir.model.fields.selection,name:product_configurator_fa.selection__product_attribute__unavailable_display__hide
#: model:ir.model.fields.selection,name:product_configurator_fa.selection__product_template_attribute_line__unavailable_display__hide
msgid "Hidden"
msgstr "Masquées"

#. module: product_configurator_fa
