<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Product Attributes -->
    <record id="product_attribute_tree_view" model="ir.ui.view">
        <field name="name">product.config.product.attribute.tree</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.attribute_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="search_ok" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="product_attribute_form_view">
        <field name="name">product.attribute.form.view</field>
        <field name="model">product.attribute</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//group[@name='main_fields']" position="before">
                <!-- ⚠️ PLUS DE `flag_config_ok` ICI, NI PLUS BAS (A1, 2026-08-28).
                     On peut cacher par DROIT ou par CHEMIN. Le droit est une propriété du
                     LECTEUR ; le chemin n'est qu'un accident de navigation — et c'est ce que
                     ce drapeau faisait : posé par le menu du configurateur et par la ligne
                     d'un produit configurable, absent du menu standard « Configuration →
                     Attributs ». Le MÊME enregistrement montrait donc des informations
                     différentes selon la porte empruntée, et un gestionnaire arrivé par la
                     porte standard ne voyait rien — pas même de quoi désarchiver.
                     Les pages ci-dessous portent déjà leur groupe : le droit suffit.
                     Constat de Gerry : « on est obligé d'aller dans configurateur pour voir
                     les informations supplémentaires des attributs ». -->
                <field
                    name="image"
                    widget="image"
                    class="oe_avatar oe_left"
                >
                    <field name="image" widget="image" class="oe_avatar oe_left" />
                </field>
            </xpath>
            <xpath expr="//group[@name='sale_main_fields']" position="inside">
                <field name="active" />
            </xpath>
            <!-- ⚠️ `create_variant` N'EST PLUS CACHÉ DERRIÈRE LE MODE DÉVELOPPEUR.
                 Constat de Gerry (2026-08-28) : « je ne vois pas dans l'attribut la
                 gestion des variants ». Le `groups="base.group_no_one"` est arrivé avec
                 le renommage en masse du fork OCA, sans raison consignée — et il
                 contredit une règle que le fork a écrite depuis.

                 ⓘ CE CHAMP N'EST PAS DÉCORATIF. `_resolves_to_values()` s'appuie sur lui :
                 *« un nombre saisi sur cet attribut se range-t-il en valeur d'attribut ?
                 La question n'a pas besoin d'un champ neuf : `create_variant` la porte
                 déjà. En `no_variant`, la valeur ne peut pas entrer dans l'identité d'une
                 variante […] et c'est tout l'objet de D-081 : le stock ne sait distinguer
                 deux portes que par leurs valeurs d'attribut. »* Il décide donc si une
                 saisie du client devient une valeur PERSISTÉE — un comportement majeur,
                 réglable jusqu'ici seulement en mode développeur.

                 Mesuré sur `fabk18` : 7 attributs en `always`, 3 en `no_variant`. Le
                 réglage VARIE déjà, sans que personne puisse le voir.

                 Il reste à sa place d'origine, auprès du type d'affichage : c'est une
                 propriété du cœur, et le cœur la protège déjà d'un changement tardif
                 (`readonly` dès qu'un produit emploie l'attribut). -->
            <!-- ─ A3 : DANS LE CORPS DE LA FICHE, PAS DANS UN ONGLET ────────────
                 Arbitrage de Gerry (2026-08-28) : *« je ne veux pas de l'onglet
                 configurator, je voudrais que les éléments viennent à la suite avant
                 les valeurs. »*

                 ⓘ Et c'est plus juste : ces réglages décrivent l'attribut LUI-MÊME,
                 au même titre que son nom et son type d'affichage. Un onglet les
                 rangeait à côté des VALEURS, qui sont autre chose — et il fallait un
                 clic pour savoir ce qu'un attribut est.

                 « Du commun au spécifique » : Description · Ce qu'une valeur est ·
                 Défauts pour une nouvelle ligne — puis les valeurs, dans leur onglet.

                 ⚠️ LE GROUPE DE DROITS DESCEND SUR CHAQUE BLOC. Il vivait sur la page ;
                 la page partie, l'oublier aurait montré ces réglages à tout le monde —
                 un élargissement de droits par déménagement. -->
            <xpath expr="//group[@name='main_fields']" position="after">
                <group
                    string="Description"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <field name="description" nolabel="1" colspan="2" />
                </group>

                <!-- ─ NATURE : ce qu'une valeur EST ───────────────────────
                     Trois notions distinctes, longtemps empilées dans deux champs :
                     le TYPE (ce que la valeur désigne), le FORMAT (comment elle se
                     lit), et l'UNITÉ.

                     ⚠️ `custom_type` a QUITTÉ la page « Custom Values », où il était
                     masqué tant que la saisie libre n'était pas cochée. Une épaisseur
                     énumérée 10 / 15 / 18 n'avait donc AUCUN format déclaré, alors que
                     la grille de prix et le moteur de géométrie lisent ces valeurs
                     comme des nombres. ⓘ Le modèle était déjà juste — `_is_numeric_custom`
                     lit `custom_type` et lui seul ; seule la vue empêchait de le saisir. -->
                <group
                    string="What a value is"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <group>
                        <field name="value_type" />
                        <!-- ⚠️ LE FORMAT ET L'UNITÉ NE VALENT QUE POUR LE TYPE
                             « VALEUR ». Constat de Gerry : « on peut choisir value type :
                             product et format integer, ça n'a pas de sens ». Un format dit
                             comment LIRE un libellé ; quand la valeur désigne un produit ou
                             une fiche, l'objet EST la réponse et il n'y a rien à lire.
                             ⓘ Le modèle refuse la combinaison de son côté — deux barrières,
                             celle de l'interface et celle qui n'en dépend pas (D-080). -->
                        <field
                            name="custom_type"
                            string="Format"
                            invisible="value_type != 'value'"
                        />
                    </group>
                    <group>
                        <!-- ⚠️ L'UNITÉ QUALIFIE UN NOMBRE — elle suit donc le format, pas
                             seulement le type. Un millimètre accolé à un mot ne veut rien
                             dire. Le modèle refuse aussi la combinaison de son côté. -->
                        <field
                            name="uom_id"
                            invisible="value_type != 'value' or custom_type not in ['integer', 'float']"
                        />
                        <field name="search_ok" />
                    </group>
                </group>

                <!-- ─ DÉFAUTS : ce dont héritera la ligne d'un NOUVEAU produit ──
                     ⚠️ Ces quatre-là ne décident de rien par eux-mêmes : c'est la ligne,
                     sur le produit, qui est lue à la configuration. Le titre du bloc le
                     dit, faute de quoi la page ferait croire à des réglages actifs — ce
                     qu'elle a fait jusqu'ici. -->
                <group
                    string="Defaults for a new product line"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <group>
                        <field name="required" />
                        <field name="multi" readonly="val_custom" force_save="1" />
                    </group>
                    <group>
                        <field name="price_mode" />
                        <field name="val_custom" readonly="multi" force_save="1" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_attributes_view">
        <field name="name">Attributes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_attribute_action_configuration"
        action="action_attributes_view"
        parent="menu_product_configurable_settings"
        sequence="10"
        groups="product.group_product_variant"
    />

    <!-- Product Attribute Value -->
    <record
        id="product_template_attribute_value_view_tree_weight_extra"
        model="ir.ui.view"
    >
        <field
            name="name"
        >product.template.attribute.value.view.tree.weight.extra</field>
        <field name="model">product.template.attribute.value</field>
        <field
            name="inherit_id"
            ref="product.product_template_attribute_value_view_tree"
        />
        <field name="type">list</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_extra']" position="after">
                <field
                    name="weight_extra"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                />
            </xpath>
        </field>
    </record>

    <record
        id="product_template_attribute_value_view_form_weight_extra"
        model="ir.ui.view"
    >
        <field
            name="name"
        >product.template.attribute.value.view.form.weight.extra</field>
        <field name="model">product.template.attribute.value</field>
        <field
            name="inherit_id"
            ref="product.product_template_attribute_value_view_form"
        />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_extra']" position="before">
                <field
                    name="weight_extra"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                />
            </xpath>
        </field>
    </record>

    <!-- Product Attribute Value -->
    <record id="product_attribute_value_list" model="ir.ui.view">
        <field name="name">product.attribute.value.list.inherit</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="attribute_id" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="product_attribute_value_form_view">
        <field name="name">product.config.product.attribute.value.form.view</field>
        <field name="model">product.attribute.value</field>
        <field name="arch" type="xml">
            <form string="Product Attribute Values">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" />
                    <div class="oe_left" style="width: 500px;">
                        <div class="oe_title" style="width: 390px;">
                            <label class="oe_edit_only" for="name" string="Value" />
                            <h1>
                                <field name="name" class="oe_inline" />
                            </h1>
                            <label for="active" />
                            <field name="active" />
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="attribute_id" />
                        </group>
                        <group>
                            <field name="product_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="variants_action" model="ir.actions.act_window">
        <field name="name">Attribute Values</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.attribute.value</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_variants_action_configuration"
        action="variants_action"
        parent="menu_product_configurable_settings"
        sequence="20"
        groups="product.group_product_variant"
    />

    <!-- ⚠️ LE TAUX AU m² N'ÉTAIT SAISISSABLE NULLE PART. Le champ existait, ses
         tests passaient — et aucun écran ne le portait : la fonctionnalité était
         complète et inatteignable (D-162). Deux vues le réparent : le catalogue
         (la valeur d'attribut, qui porte le défaut) et le produit (la valeur du
         template, qui peut le surcharger). -->
    <record id="product_attribute_view_form_sqm" model="ir.ui.view">
        <field name="name">product.attribute.form.sqm</field>
        <!-- ⚠️ Le modèle est celui de la vue PARENTE (`product.attribute`), pas
             celui de la liste qu'on complète : la colonne vit à l'intérieur du
             `value_ids`, la vue héritée reste celle de l'attribut. -->
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <!-- ⚠️ UN SEUL MONTANT, ET EN FIN DE LIGNE. Constat de Gerry :
                 « default_extra_price ne peut pas être visible en même temps que
                 default_extra_price_sqm, c'est l'un ou l'autre en fin de ligne ».

                 ⚠️ Et ce n'est PAS cosmétique. Le module le dit lui-même à propos du
                 taux : « Odoo somme `price_extra` partout, et y ranger 25 €/m² le
                 ferait facturer 25 € ». Les deux champs côte à côte invitent à
                 remplir les deux — et le montant fixe serait alors facturé EN PLUS
                 du mètre carré, sans erreur et sans trace.

                 ⓘ Le mode de l'attribut n'est qu'une SEMENCE (A4) : c'est la ligne
                 du produit qui décide. Masquer par lui reste juste, parce qu'une
                 ligne n'a qu'un seul mode — on sème donc le mode ET le montant qui
                 lui correspond, jamais l'autre. -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='default_extra_price']" position="attributes">
                <attribute name="column_invisible">parent.price_mode == 'per_sqm'</attribute>
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='default_extra_price']" position="after">
                <field
                    name="default_extra_price_sqm"
                    column_invisible="parent.price_mode != 'per_sqm'"
                />
            </xpath>
        </field>
    </record>

    <!-- ══ CE QUE `value_type` GOUVERNE DANS LA LISTE DES VALEURS (D-196) ══════
         Constat de Gerry : « l'affichage des champs de liste des valeurs d'attribut
         est influencé par le type d'affichage, mais il est influencé aussi par Value
         type ». Deux axes commandaient cette liste, et un seul était câblé.

         ⚠️ LES DEUX AXES RESTENT INDÉPENDANTS DANS LEUR CHOIX. `display_type` dit
         comment on CHOISIT (pastilles, liste déroulante, cases) ; `value_type` dit ce
         que la valeur DÉSIGNE. Un attribut de type « matière » affiché en `select` est
         parfaitement légitime. Les coupler serait refaire l'erreur du format (D-194)
         dans l'autre sens : ils gouvernent des colonnes différentes, pas les mêmes. -->
    <record id="product_attribute_view_form_value_type" model="ir.ui.view">
        <field name="name">product.attribute.form.value.type</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <!-- La liste lit `parent.value_type` : il doit être dans la vue parente,
                 et il y est (groupe « What a value is »). -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field
                    name="product_id"
                    column_invisible="parent.value_type != 'product'"
                    options="{'no_create': True}"
                />
            </xpath>

            <!-- ⚠️ « Texte libre » QUITTE LA COLONNE. Constat de Gerry : « il y a déjà
                 Default: customer may add a value, donc texte libre n'a pas d'intérêt
                 en colonne ».

                 ⓘ Ce que la mesure a montré, et qu'il faut savoir : les deux drapeaux
                 ne servent PAS le même configurateur. `val_custom` (attribut) est celui
                 que NOTRE assistant lit — `self.custom = self.attribute_id.val_custom`.
                 `is_custom` (valeur) n'est lu nulle part dans le fork : il n'est lu que
                 par le configurateur NATIF d'Odoo et par `website_sale`. Le masquer ne
                 retire donc rien à nos produits configurables ; il retire le seul écran
                 où l'on réglait la saisie libre native, pour un produit qui n'est pas
                 `config_ok`. Une ligne à remettre si le besoin s'en présente. -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='is_custom']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <!-- La pastille et la vignette ne valent que pour une valeur qui ne désigne
                 QU'ELLE-MÊME : un produit a son image, une matière a sa miniature PBR.
                 ⓘ La condition du core sur `display_type` est CONSERVÉE et complétée —
                 les deux axes s'ajoutent, aucun ne remplace l'autre. -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='html_color']" position="attributes">
                <attribute name="column_invisible">parent.display_type != 'color' or parent.value_type != 'value'</attribute>
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='image']" position="attributes">
                <attribute name="column_invisible">parent.display_type != 'color' or parent.value_type != 'value'</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_attribute_value_view_tree_sqm" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.sqm</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree" />
        <field name="arch" type="xml">
            <!-- ⚠️ MÊME RÈGLE QUE SUR LE CATALOGUE, mais PAR LIGNE et non par
                 colonne : `price_mode` est lié à la ligne d'attribut, et cette liste
                 peut mêler des lignes de modes différents. `column_invisible` ne
                 s'évalue que sur le contexte parent — seul `invisible`, évalué par
                 enregistrement, sait vider la bonne cellule.

                 ⚠️ Le montant fixe DISPARAÎT en mode m², il ne devient pas seulement
                 lecture seule : un zéro affiché à côté d'un taux se lit comme « pas
                 de supplément », alors qu'il y en a un — et un champ modifiable
                 aurait invité à le remplir, ce qu'Odoo aurait facturé en plus. -->
            <xpath expr="//field[@name='price_extra']" position="attributes">
                <attribute name="invisible">price_mode == 'per_sqm'</attribute>
            </xpath>
            <xpath expr="//field[@name='price_extra']" position="after">
                <field name="price_mode" column_invisible="True" />
                <field
                    name="price_extra_sqm"
                    widget="monetary"
                    options="{'field_digits': True}"
                    column_invisible="context.get('hide_sqm', False)"
                    invisible="price_mode != 'per_sqm'"
                />
            </xpath>
        </field>
    </record>

    <record id="product_attribute_value_form_sqm" model="ir.ui.view">
        <field name="name">product.attribute.line.value.form.sqm</field>
        <field name="model">product.template.attribute.line</field>
        <field name="inherit_id" ref="product.product_template_attribute_line_form" />
        <field name="arch" type="xml">
            <!-- Le formulaire d'une VALEUR, ouvert depuis la liste : sans lui, le
                 taux ne se voyait qu'en colonne, et pas du tout sur la fiche. -->
            <xpath expr="//field[@name='value_ids']/form/field[@name='name']" position="after">
                <field name="price_mode" invisible="1" />
                <field
                    name="default_extra_price_sqm"
                    invisible="price_mode != 'per_sqm'"
                />
                <!-- ⓘ Le montant fixe n'est PAS sur cette fiche (le core ne l'y met
                     pas) : il n'y a donc rien à masquer ici, et rien qui contredise
                     le taux. Noté pour qu'un lecteur ne cherche pas la symétrie. -->
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="price_mode" column_invisible="True" />
                <field
                    name="default_extra_price_sqm"
                    column_invisible="parent.price_mode != 'per_sqm'"
                />
            </xpath>
        </field>
    </record>

    <record id="product_template_attribute_value_form_sqm" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.sqm</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form" />
        <field name="arch" type="xml">
            <!-- La même exclusivité que dans la liste : sur la fiche aussi, un seul
                 des deux montants a un sens, et le fixe se facturerait EN PLUS. -->
            <xpath expr="//field[@name='price_extra']" position="attributes">
                <attribute name="invisible">price_mode == 'per_sqm'</attribute>
            </xpath>
            <xpath expr="//field[@name='price_extra']" position="after">
                <field name="price_mode" invisible="1" />
                <field
                    name="price_extra_sqm"
                    widget="monetary"
                    options="{'field_digits': True}"
                    invisible="price_mode != 'per_sqm'"
                />
            </xpath>
        </field>
    </record>

    <!-- Product Attribute Line -->
    <record id="product_template_attribute_line_form_config" model="ir.ui.view">
        <field name="name">product.template.attribute.line.form</field>
        <field name="model">product.template.attribute.line</field>
        <field name="inherit_id" ref="product.product_template_attribute_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_field']" position="after">
                <field name="attribute_custom_type" invisible="1" />
                <group name="configurator_pricing" string="Configurator">
                    <field name="dimension_role" />
                    <field name="price_mode" />
                    <field name="visibility_domain_id" />
                </group>
                <group
                    name="bounds"
                    string="Bounds"
                    invisible="attribute_custom_type not in ['integer', 'float']"
                >
                    <group>
                        <label for="min_val" />
                        <div class="o_row">
                            <field name="has_min_val" />
                            <field name="min_val" invisible="not has_min_val" />
                        </div>
                        <label for="max_val" />
                        <div class="o_row">
                            <field name="has_max_val" />
                            <field name="max_val" invisible="not has_max_val" />
                        </div>
                        <field name="step" />
                    </group>
                    <field name="bound_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="domain_id" />
                            <field name="has_min_val" />
                            <field name="min_val" readonly="not has_min_val" />
                            <field name="has_max_val" />
                            <field name="max_val" readonly="not has_max_val" />
                            <field name="step" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
