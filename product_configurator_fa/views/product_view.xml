<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_config_inherited" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="priority">16</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- ⚠️ CONSERVÉ malgré la case ci-dessous. Ce champ caché sert au bouton
                     « Configure Product », qui vit dans l'AUTRE vue (`product_template_only_
                     form_view`) : l'y retirer parce qu'il fait doublon ICI casserait son
                     `invisible="not config_ok"` là-bas. -->
                <field name="config_ok" invisible="1" />
            </xpath>

            <!-- « Peut être configuré », à la suite de « Peut être vendu » et « Peut être
                 acheté » — demande de Gerry (2026-08-27), en remplacement du bouton
                 d'action qui vivait dans la boîte à boutons.

                 ⓘ Même patron que le cœur : `account` ajoute « Peut être acheté » par un
                 `<div name="options" position="inside">` sur cette même vue. Sa priorité
                 est 5, celle-ci 16 : l'ordre d'affichage suit donc les priorités, sans
                 rien à coordonner.

                 ⚠️ Le GROUPE est celui du bouton qu'on remplace. Sans lui, n'importe quel
                 utilisateur rendrait un produit configurable — un droit que la boîte à
                 boutons réservait au gestionnaire, et qu'une case ne doit pas élargir au
                 passage. -->
            <div name="options" position="inside">
                <span
                    class="d-inline-flex"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <field name="config_ok" />
                    <label for="config_ok" />
                </span>
            </div>
        </field>
    </record>

    <record id="product_template_only_form_view_inherited" model="ir.ui.view">
        <field name="name">product.configurator.product.template.form</field>
        <field name="model">product.template</field>
        <field name="priority">16</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <!-- ══ LA GRILLE SE RANGE AVEC LA LISTE DE PRIX — D-214 ═══════════
                 Question de Gerry. Elles ne décident pas la même chose — la
                 grille PRODUIT le prix d'un produit dimensionné, la liste de prix
                 l'AJUSTE — mais elles répondent à la même question : « où se
                 règle le prix ? ». Deux portes éloignées pour une seule question,
                 c'est une porte de trop.

                 ⚠️ **ET DANS LA VUE « ONLY », PAS DANS CELLE DU MODÈLE.**
                 `product.product_normal_form_view` — le formulaire de la VARIANTE —
                 **hérite** de `product_template_form_view` : tout ce qu'on y ajoute
                 descend dans la variante, où `action_open_price_grids` n'existe pas.
                 Odoo refuse alors la vue entière : *« action_open_price_grids is not
                 a valid action on product.product »*. La vue « only » est justement
                 celle que la variante ne reprend pas ([[L-166]]). -->
            <xpath expr="//button[@name='open_pricelist_rules']" position="after">
                <button
                    class="oe_stat_button"
                    name="action_open_price_grids"
                    icon="fa-th"
                    type="object"
                    invisible="not config_ok"
                    groups="product_configurator_fa.group_product_configurator_fa"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="price_grid_count" />
                        </span>
                        <span class="o_stat_text">Price grids</span>
                    </div>
                </button>
            </xpath>

            <xpath expr='//header' position="inside">
                <button
                    name="configure_product"
                    class="oe_highlight"
                    type="object"
                    string="Configure Product"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    invisible="not config_ok"
                />
            </xpath>
            <!-- ⓘ Le bouton d'action « Configurable » de la boîte à boutons a été RETIRÉ
                 (Gerry, 2026-08-27) : la case à cocher de la vue commune le remplace, à côté
                 de « Peut être vendu » et « Peut être acheté ». Un état booléen se lit mieux
                 dans une case que dans un bouton qui dit tantôt « Configurable », tantôt
                 « Standard ».

                 ⚠️ La MÉTHODE `toggle_config`, elle, RESTE : elle est publique, couverte par
                 `test_03_toggle_config`, et un autre module peut l'appeler. Retirer un bouton
                 n'est pas retirer une API. -->
            <xpath
                expr="//label[@for='purchase_ok' or @for='sale_ok']"
                position="after"
            >
                <div class="oe_left" name="options" groups="base.group_user">
                    <field name="id" invisible="True" />
                </div>
            </xpath>

            <!-- Product attributes -->
            <xpath expr="//field[@name='attribute_line_ids']" position="attributes">
                <attribute
                    name="context"
                >{'default_config_ok': context.get('default_config_ok', False)}</attribute>
            </xpath>

            <!-- TODO: Implement a method to hide this field for non-configurable product templates -->
            <xpath
                expr="//field[@name='attribute_line_ids']/list/field[@name='value_ids']"
                position="after"
            >
                <field
                    name="default_val"
                    domain="[('id', 'in', value_ids)]"
                    context="{'show_attribute': False}"
                    options="{'no_create': True, 'no_create_edit': True}"
                    column_invisible="not context.get('default_config_ok', False)"
                />
                <field
                    name="required"
                    column_invisible="not context.get('default_config_ok', False)"
                />
                <field
                    name="required_condition"
                    column_invisible="not context.get('default_config_ok', False)"
                    optional="hide"
                    groups="base.group_no_one"
                />
                <field
                    name="readonly_condition"
                    column_invisible="not context.get('default_config_ok', False)"
                    optional="hide"
                    groups="base.group_no_one"
                />
                <field
                    name="invisible_condition"
                    column_invisible="not context.get('default_config_ok', False)"
                    optional="hide"
                    groups="base.group_no_one"
                />
                <field
                    name="multi"
                    column_invisible="not context.get('default_config_ok', False)"
                    readonly="custom"
                    force_save="1"
                />
                <field
                    name="custom"
                    column_invisible="not context.get('default_config_ok', False)"
                    readonly="multi"
                    force_save="1"
                />
            </xpath>

            <xpath
                expr="//field[@name='attribute_line_ids']/list/field[@name='value_ids']"
                position="attributes"
            >
                <attribute name="required">not custom</attribute>
            </xpath>


            <!-- TODO: Apply domains so only values from template are available -->
            <xpath expr="//notebook/page[@name='variants']" position="after">
                <page
                    string="Configurator"
                    name="configurator"
                    invisible="not config_ok"
                    groups="product_configurator_fa.group_product_configurator_fa"
                >
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not price_grid_warning"
                    >
                        <field name="price_grid_warning" nolabel="1" readonly="1" />
                    </div>
                    <!-- ══ L'ARBRE DU CONFIGURATEUR — la maquette de Gerry ═══════════
                         ⚠️ **CES COLONNES VIVENT ICI, ET NULLE PART AILLEURS.** Je les
                         avais d'abord posées dans « Attributs & Variantes » en lisant
                         Q2 — *« un seul ordre, partagé »* — comme *« les mêmes
                         colonnes ». Gerry l'a corrigé : *« l'onglet attribut et
                         variant ne devait pas changer »*. Partager l'ORDRE n'est pas
                         partager l'AFFICHAGE : c'est le même `attribute_line_ids`, donc
                         la même séquence, montré autrement.

                         ⓘ Ce qui manque encore à la maquette, et qui n'est pas natif :
                         le second niveau (les VALEURS sous leur attribut) et la ligne
                         d'étape en propre. Les deux demandent un composant sur mesure —
                         une liste Odoo ne sait pas mêler deux modèles ni s'imbriquer. -->
                    <separator colspan="4" string="Attributes" name="configurator_tree" />
                    <!-- ⚠️ L'ARBRE, tel que la maquette le demande (D-210) : étape en
                         bandeau, attribut, valeurs indentées. Une liste Odoo ne sait
                         ni s'imbriquer ni mêler deux modèles — d'où le composant.

                         ⚠️ ET IL EST SEUL : un même `One2many` déclaré deux fois dans
                         un formulaire casse la sauvegarde (D-209, mesuré). L'arbre
                         remplace donc la liste — on règle une ligne en l'ouvrant, et
                         on ajoute par les liens du pied. -->
                    <field name="configurator_line_ids" widget="configurator_tree" nolabel="1" />

                </page>
                <!-- ══ LES RÉGLAGES QUI NE SONT PAS L'ARBRE — D-213 ═══════════════
                     Gerry : « dans l'onglet configurateur, peux-tu retirer
                     Configuration Images et Variant Name ». ⚠️ RETIRÉES DE
                     L'ONGLET, PAS SUPPRIMÉES : ces réglages n'ont d'équivalent
                     nulle part, et les effacer les rendrait injoignables. Ils
                     prennent donc un onglet à eux, où ils ne gênent plus la
                     lecture de l'arbre. -->
                <page
                    string="Configurator settings"
                    name="configurator_settings"
                    invisible="not config_ok"
                    groups="product_configurator_fa.group_product_configurator_fa"
                >
                    <separator
                        colspan="4"
                        string="Configuration Images"
                        name="configurator_images"
                    />
                    <field name="config_image_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field
                                name="value_ids"
                                widget="many2many_tags"
                                context="{'_cfg_product_tmpl_id': parent.id}"
                            />
                            <field
                                name="image_1920"
                                widget="image"
                                class="oe_prod_config_image"
                            />
                        </list>
                    </field>
                    <field name="attribute_line_val_ids" invisible="1" />
                    <field name="attribute_value_line_ids" invisible="1">
                        <list
                            editable="bottom"
                            context="{'default_product_tmpl_id': self.id}"
                        >
                            <field name="product_tmpl_id" invisible="1" />
                            <field name="attribute_id" invisible="1" />
                            <field name="sequence" widget="handle" />
                            <field
                                name="value_id"
                                domain="[('id', 'in', parent.attribute_line_val_ids)]"
                            />
                            <field
                                name="value_ids"
                                domain="[
                                ('id', 'in', parent.attribute_line_val_ids),
                                ('attribute_id', '!=', attribute_id)
                               ]"
                                widget="many2many_tags"
                            />
                        </list>
                    </field>
                    <separator
                        string="Variant Name"
                        colspan="4"
                        groups="product_configurator_fa.group_product_configurator_fa_manager"
                    />
                    <field
                        name="mako_tmpl_name"
                        groups="product_configurator_fa.group_product_configurator_fa_manager"
                    />
                </page>
            </xpath>

            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="invisible">config_ok</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.configurator.product.template.search.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <separator />
                <filter
                    string="Standard Products"
                    name="filter_standard_products"
                    domain="[('config_ok','=',False)]"
                />
                <filter
                    string="Configurable Products"
                    name="filter_config_ok"
                    domain="[('config_ok','=',True)]"
                />
            </xpath>
        </field>
    </record>

    <record id="template_view_tree_configurable" model="ir.ui.view">
        <field name="name">product.template.product.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute
                    name="invisible"
                >context.get('default_config_ok', 0)</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view_inherited" model="ir.ui.view">
        <field name="name">Product.template.product.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="config_ok" />
            </xpath>
            <xpath expr="//field[@name='is_favorite']" position="before">
                <div
                    class="float-end"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    invisible="not config_ok"
                >
                    <a name="configure_product" type="object">
                        <i class="fa fa-wrench fa-lg" title="Configure Product" />
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_form_view_custom_vals_inherit" model="ir.ui.view">
        <field name="name">product.configurator.form.view.custom.vals</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr='//header' position="inside">
                <button
                    name="reconfigure_product"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    class="oe_highlight"
                    type="object"
                    string="Reconfigure Product"
                    invisible="not config_ok"
                />
            </xpath>
            <!-- <xpath expr="//button[@name='toggle_config']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            <xpath expr="//div[@name='options']" position="inside">
                <field name="config_preset_ok" invisible="not config_ok" />
                <label for="config_preset_ok" invisible="not config_ok" />
            </xpath>
        </field>
    </record>

    <record id="product_variant_easy_edit_view_inherit" model="ir.ui.view">
        <field name="name">product.product.view.form.easy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="config_ok" invisible="1" />
                <field name="config_preset_ok" invisible="not config_ok" />
            </xpath>
            <xpath expr="//field[@name='weight']" position="attributes">
                <attribute name="readonly">config_ok</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_kanban_view_inherited" model="ir.ui.view">
        <field name="name">Product Kanban</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="config_ok" />
            </xpath>
            <xpath expr="//field[@name='is_favorite']" position="before">
                <div
                    class="float-end"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    invisible="not config_ok"
                >
                    <a
                        name="reconfigure_product"
                        type="object"
                        class="fa fa-repeat fa-lg"
                        title="Reconfigure Product"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
