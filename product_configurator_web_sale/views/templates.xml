<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══ LA FICHE PRODUIT ═══════════════════════════════════════════════════
         « Ajouter au panier » devient « Configurer ». Le bouton n'est pas
         renommé : il change de DESTINATION — la configuration, pas le panier.

         ⚠️ **LE BOUTON EST HORS DU FORMULAIRE, ET C'EST OBLIGATOIRE.** Mesuré à
         l'exécution : un produit configurable n'a AUCUNE variante
         (le fork ne les crée qu'à la confirmation d'une configuration), donc
         `_is_add_to_cart_possible()` est FAUX, donc le `<form>` d'Odoo — prix,
         sélecteurs, bouton — ne se rend pas du tout, et la page affiche à sa
         place *« This product has no valid combination »*. Un bouton placé
         dans ce formulaire n'apparaîtrait donc JAMAIS sur un produit
         configurable : c'est-à-dire exactement là où on le veut. -->
    <template id="product_configure_button" inherit_id="website_sale.product"
              name="Configurable product: Configure instead of Add to cart">

        <!-- 1. Le bouton, avant le formulaire, donc indépendant de son sort. -->
        <xpath expr="//div[@id='product_details']//form[@action='/shop/cart/update']"
               position="before">
            <div t-if="product.config_ok" id="configure_wrap" class="d-flex mb-3">
                <!-- ⚠️ **CE RESTE UN VRAI LIEN**, et c'est la garantie. Le composant
                     ci-dessous détourne son clic UNE FOIS la configuration prête ;
                     avant cela — ou si le JavaScript échoue — il navigue comme avant.
                     La promesse « sans attente » se dégrade, elle ne casse pas. -->
                <a role="button" class="btn btn-primary o_cfg3d_configure"
                   t-attf-href="/configurator/start/#{slug(product)}">
                    <i class="fa fa-pencil me-2"/>Configure
                </a>
                <!-- Prépare la configuration pendant que le visiteur lit la fiche :
                     un jeton, l'état, et la scène construite d'avance. -->
                <owl-component name="product_configurator_web_sale.ConfiguratorOverlay"
                               t-att-props="json.dumps({'productTmplId': product.id})"/>
            </div>
        </xpath>

        <!-- 2. Le panier s'efface — sans quoi la page offrirait deux gestes qui ne
             mènent pas au même endroit. -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-if">not product.config_ok</attribute>
        </xpath>

        <!-- 5. ⚠️ Et le message qui MENT s'arrête. « Cette combinaison n'existe
             pas » est la retombée du `t-else` d'Odoo : vrai pour un produit
             ordinaire sans variante vendable, FAUX pour un produit
             configurable, dont c'est l'état normal avant la première
             configuration. -->
        <xpath expr="//p[@t-else=''][hasclass('alert-warning')]" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">not product.config_ok</attribute>
        </xpath>
    </template>

    <!-- ══ LES QUESTIONS ET LE « À PARTIR DE » : UNE VUE À PART ════════════════
         ⚠️ **Une vue NEUVE, et c'est ce qui les fait servir** (D-392) : l'éditeur de site
         fait de `product_configure_button` une COPIE propre au site, qu'il FIGE
         (`arch_updated`), et une règle ajoutée là n'est jamais servie ([[L-356]]).

         Une vue enfant NEUVE échappe à cela : à l'installation, `website` en crée une
         copie fraîche sous chaque copie de site du parent (`_create_all_specific_views`),
         sans toucher à celles qui sont figées. Remettre la copie à zéro, au contraire, ne
         tiendrait que jusqu'à la prochaine retouche de la fiche dans l'éditeur. -->
    <template id="product_configure_questions_hidden" inherit_id="website_sale.product"
              name="Configurable product: no attribute selectors, price from">
        <!-- 3. ⚠️ **ET LES QUESTIONS S'EFFACENT AVEC LUI** (D-392) : dès qu'une configuration
             a créé une variante, la fiche reposerait les QUESTIONS DU CONFIGURATEUR.
             ⚠️ La même question aurait deux mémoires, et son choix n'est suivi d'aucun bouton.
             ⚠️ La forme « carte » y serait dégradée en pastilles par le repli ci-dessous.

             ⓘ Le PRIX reste — voir le point 4. C'est la seule chose que la fiche ait
             encore à dire d'un produit qu'on n'a pas configuré. -->
        <xpath expr="//t[@t-call='website_sale.variants']" position="attributes">
            <attribute name="t-if">not product.config_ok</attribute>
        </xpath>

        <!-- 4. LE PRIX DEVIENT UN « À PARTIR DE » (D-093 le disait déjà de la donnée).
             Un produit qu'on n'a pas encore configuré n'a pas de prix ferme : l'annoncer
             comme tel promet un montant que la configuration démentira.

             ⚠️ **CE QUE CE MONTANT EST, EXACTEMENT** : le prix de la combinaison PAR
             DÉFAUT, tel qu'Odoo le calcule — remises et taxes comprises. Pour un produit
             tarifé par GRILLE c'est déjà le minimum, `_refresh_grid_list_price` ayant mis
             le plus bas de la grille dans le `list_price` (D-093). Il ne l'est PAS encore
             quand des réponses portent un `price_extra` : le vrai plancher demande alors de
             chercher la combinaison admissible la moins chère, ce que personne ne sait
             faire ici — une exclusion peut rendre invalide le « moins cher de chaque
             question ». ⓘ Lot à part, non tranché.

             ⓘ Rien quand le prix est nul : « À partir de 0 € » est pire que le silence.
             ⓘ À côté du prix, mais du même style que sur la vignette (D-536). -->
        <xpath expr="//t[@t-call='website_sale.product_price']" position="before">
            <span t-if="product.config_ok and combination_info['price']"
                  class="o_cfg3d_from me-1 small text-o-color-2">From</span>
        </xpath>
    </template>

    <!-- ══ LE CRAYON DU BOUTON « CONFIGURER », MÊME SUR UNE FICHE FIGÉE ═════
         ⚠️ Une copie de site figée de `product_configure_button` garderait l'ancienne icône :
         vue NEUVE (L-356, D-392).
         ⓘ Le crayon partout où l'on configure, comme la ligne de devis d'Odoo (D-538). -->
    <template id="product_configure_button_pencil" inherit_id="website_sale.product"
              name="Configurable product: pencil on the Configure button">
        <xpath expr="//a[hasclass('o_cfg3d_configure')]/i" position="attributes">
            <attribute name="class">fa fa-pencil me-2</attribute>
        </xpath>
    </template>

    <!-- ══ LA VIGNETTE DE LA GRILLE ═══════════════════════════════════════════
         Le même geste dans la liste de la boutique. L'ajout RAPIDE (l'icône de
         panier) disparaît par `_website_show_quick_add()` — en Python, parce que
         la vue qui le porte est optionnelle et peut être éteinte. -->
    <template id="products_item_configure" inherit_id="website_sale.products_item"
              name="Configurable product: Configure button on the grid item">
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="inside">
            <!-- ⚠️ Sans `btn-sm`, comme le cœur et le panier d'Odoo : étiré à leur hauteur, un
                 bouton plus petit gardait son icône en haut (D-538). -->
            <a t-if="product.config_ok" role="button" class="btn btn-primary"
               t-attf-href="/configurator/start/#{slug(product)}"
               aria-label="Configure" title="Configure">
                <span class="fa fa-pencil" role="img"/>
            </a>
        </xpath>
    </template>

    <!-- ══ LE CRAYON DE LA VIGNETTE, MÊME SUR UNE BOUTIQUE FIGÉE ══════════════
         ⚠️ Un « Enregistrer » de la boutique dans l'éditeur fige `products_item_configure` sur le
         site : vue NEUVE (L-356, D-392).
         ⚠️ APRÈS `products_item_configure` dans ce fichier : déclarée avant, elle s'appliquerait la
         première sur une base neuve, ne trouverait pas le bouton, et l'installation échouerait.
         ⓘ Le crayon suit l'option panier de la rangée « Boutons » de la boutique, comme le panier
         d'Odoo (D-539). -->
    <template id="products_item_configure_pencil" inherit_id="website_sale.products_item"
              name="Configurable product: pencil on the grid item">
        <xpath expr="//div[hasclass('o_wsale_product_btn')]/a[@t-if='product.config_ok']" position="attributes">
            <attribute name="class">btn btn-primary</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_btn')]/a[@t-if='product.config_ok']/*[1]" position="attributes">
            <attribute name="class">fa fa-pencil</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_btn')]/a[@t-if='product.config_ok']" position="attributes">
            <attribute name="t-if">product.config_ok and is_view_active('website_sale.products_add_to_cart')</attribute>
        </xpath>
    </template>

    <!-- ══ LE « À PARTIR DE » DE LA VIGNETTE : UNE VUE À PART ═════════════════
         ⚠️ Une règle ajoutée à `products_item_configure` ne serait pas servie par une copie
         de site figée : vue NEUVE (L-356, D-392).
         ⓘ Le montant est celui de la fiche — `_get_sales_prices`, côté Python (D-536). -->
    <template id="products_item_price_from" inherit_id="website_sale.products_item"
              name="Configurable product: price from on the grid item">
        <!-- ⚠️ Sans `text-end`, la mention, plus large que le prix, le laisserait à gauche
             sous elle (D-536). -->
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="class" add="text-end" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('product_price')]/span[1]" position="before">
            <div t-if="product.config_ok and template_price_vals['price_reduce']"
                 class="o_cfg3d_from small text-o-color-2">From</div>
        </xpath>
    </template>

    <!-- ══ LA CARTE ET LA GRANDE PASTILLE SUR LA FICHE, COMME AU CONFIGURATEUR (D-563) ══════════
         ⚠️ `website_sale.variants` n'a pas de cas par défaut : sans cette branche, une forme d'ici ne rend rien,
         sans erreur (D-258).
         ⚠️ La « Couleur » du cœur ne lit que l'image POSÉE sur la valeur : une valeur qui désigne une matière
         ou un produit restait un damier (D-563). -->
    <template id="variants_card_fallback" inherit_id="website_sale.variants"
              name="Card and large swatch display types on standard pages">
        <xpath expr="//t[@t-elif=&quot;attribute.display_type == 'color'&quot;]" position="before">
            <t t-elif="attribute.display_type in ('card', 'swatch')">
                <t t-call="product_configurator_web_sale.variant_image_answers"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-elif=&quot;attribute.display_type == 'color'&quot;]//t[@t-set='img_style']"
               position="before">
            <t t-set="ptav_preview" t-value="ptav.product_attribute_value_id._preview_url()"/>
        </xpath>
        <xpath expr="//t[@t-elif=&quot;attribute.display_type == 'color'&quot;]//t[@t-set='img_style']"
               position="attributes">
            <attribute name="t-value">'background:url(%s); background-size:cover;' % ptav_preview if ptav_preview else ''</attribute>
        </xpath>
    </template>

    <!-- ⓘ Le dessin de `product_configurator_web_3d.Card` et `.BigSwatch` : mêmes classes, même feuille.
         ⚠️ Un `<label>` autour du bouton radio : `sale_variant_mixin` pose `css_not_available` sur le libellé
         parent d'une réponse exclue (D-563).
         ⚠️ Le bouton radio garde `js_variant_change` et ses `data-*` : c'est par eux qu'Odoo lit la combinaison
         (D-563).
         ⓘ Toujours la liste complète : la rangée qui défile et la ligne résumé demandent le panneau du
         configurateur (D-563). -->
    <template id="variant_image_answers" name="Card and large swatch answers">
        <t t-set="is_swatch" t-value="attribute.display_type == 'swatch'"/>
        <t t-set="answer_form" t-value="'bigswatch' if is_swatch else 'card'"/>
        <div t-att-data-attribute_id="attribute.id"
             t-attf-class="o_wsale_product_attribute #{'o_cfg3d_bigswatches o_cfg3d_bigswatches--%s o_cfg3d_bigswatches--%s' % (attribute.swatch_mark, attribute.answer_size) if is_swatch else 'o_cfg3d_cards o_cfg3d_cards--%s' % attribute.answer_size} #{'d-none' if single_and_custom else ''}">
            <t t-foreach="ptavs" t-as="ptav">
                <t t-set="ptav_preview" t-value="ptav.product_attribute_value_id._preview_url()"/>
                <label t-attf-class="o_cfg3d_#{answer_form}" t-att-title="ptav.name if is_swatch else None">
                    <input type="radio"
                           t-attf-class="visually-hidden js_variant_change #{attribute.create_variant}"
                           t-att-checked="ptav in combination"
                           t-att-name="'ptal-%s' % ptal.id"
                           t-att-value="ptav.id"
                           t-att-title="ptav.name"
                           t-att-data-attribute-value-id="ptav.product_attribute_value_id.id"
                           t-att-data-value_id="ptav.id"
                           t-att-data-value_name="ptav.name"
                           t-att-data-attribute_name="attribute.name"
                           t-att-data-is_custom="ptav.is_custom"
                           t-att-data-is_single="single"
                           t-att-data-is_single_and_custom="single_and_custom"/>
                    <t t-if="is_swatch">
                        <span class="o_cfg3d_bigswatch_disc"
                              t-att-style="'background-color: %s' % ptav.html_color if ptav.html_color else None">
                            <img t-if="ptav_preview" t-att-src="ptav_preview" t-att-alt="ptav.name" loading="lazy"/>
                            <span t-if="attribute.swatch_mark != 'ring'" class="o_cfg3d_bigswatch_check">
                                <i class="fa fa-check"/>
                            </span>
                        </span>
                        <span class="o_cfg3d_bigswatch_label" t-field="ptav.name"/>
                    </t>
                    <t t-else="">
                        <!-- ⚠️ Pas de cadre sans image : une vignette vide se lit comme un chargement en panne
                             (D-262). -->
                        <span t-if="ptav_preview" class="o_cfg3d_card_shot">
                            <img t-att-src="ptav_preview" t-att-alt="ptav.name" loading="lazy"/>
                        </span>
                        <span class="o_cfg3d_card_label" t-field="ptav.name"/>
                    </t>
                    <t t-set="price_extra" t-value="ptav._get_extra_price(combination_info)"/>
                    <!-- ⓘ Le montant du badge d'Odoo (`website_sale.badge_extra_price`), dans le badge du configurateur. -->
                    <span t-if="price_extra" class="o_cfg3d_extra">
                        <span class="o_cfg3d_extra_sign" t-out="price_extra &gt; 0 and '+' or '-'"/>
                        <span class="o_cfg3d_extra_amount" t-out="abs(price_extra)"
                              t-options='{"widget": "monetary", "display_currency": (website.pricelist_id or product.env.company).currency_id}'/>
                    </span>
                </label>
            </t>
        </div>
    </template>

    <!-- ══ MODIFIER UNE CONFIGURATION DEPUIS LE PANIER (D-556) ═══════════════════
         ⓘ Le lien rouvre la configuration de la ligne ; la confirmer met la ligne à jour et
         ramène au panier.
         ⚠️ Avant « Supprimer », qui porte la classe de l'action : ce lien-ci n'en porte aucune,
         sinon le clic supprimerait la ligne au lieu de l'ouvrir. -->
    <template id="cart_line_edit_configuration" inherit_id="website_sale.cart_lines"
              name="Configured product: Edit from the cart">
        <xpath expr="//div[@name='o_wsale_cart_line_button_container']/a[hasclass('js_delete_product')]"
               position="before">
            <t t-set="cfg_edit_url" t-value="line._configurator_edit_url()"/>
            <a t-if="cfg_edit_url" t-att-href="cfg_edit_url"
               class="o_cfg3d_cart_edit d-none d-md-inline-block small pe-2 me-2 border-end"
               title="Edit this configuration">Edit</a>
        </xpath>
        <xpath expr="//div[@name='o_wsale_cart_line_button_container']/button[hasclass('js_delete_product')]"
               position="before">
            <a t-if="cfg_edit_url" t-att-href="cfg_edit_url"
               class="o_cfg3d_cart_edit btn btn-light d-inline-block d-md-none"
               title="Edit this configuration" aria-label="Edit this configuration">
                <i class="fa fa-pencil"/>
            </a>
        </xpath>
    </template>

    <!-- ══ LE TEXTE DU BOUTON « CONFIGURER », RÉGLÉ DANS LES PARAMÈTRES (D-558) ═══════
         ⚠️ Vues NEUVES : une copie de site figée par l'éditeur ne servirait pas un changement des vues
         d'origine (L-356, D-392).
         ⚠️ APRÈS `product_configure_button` et `products_item_configure` dans ce fichier : elles
         modifient leurs boutons, qui doivent déjà exister sur une base neuve. -->
    <template id="product_configure_button_label" inherit_id="website_sale.product"
              name="Configurable product: Configure button text from the settings">
        <!-- ⓘ `inner` : le mot est la queue de texte de l'icône, qu'aucun xpath ne vise. -->
        <xpath expr="//a[hasclass('o_cfg3d_configure')]" position="replace" mode="inner">
            <i class="fa fa-pencil me-2"/><t t-out="website._configure_button_label()"/>
        </xpath>
    </template>

    <template id="products_item_configure_label" inherit_id="website_sale.products_item"
              name="Configurable product: grid Configure tooltip from the settings">
        <xpath expr="//div[hasclass('o_wsale_product_btn')]/a[contains(@t-attf-href, '/configurator/start/')]"
               position="attributes">
            <attribute name="title"/>
            <attribute name="aria-label"/>
            <attribute name="t-att-title">website._configure_button_label()</attribute>
            <attribute name="t-att-aria-label">website._configure_button_label()</attribute>
        </xpath>
    </template>

</odoo>
