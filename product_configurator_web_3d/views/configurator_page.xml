<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         LA PAGE PUBLIQUE — nue (lot 6, D-090)
         ══════════════════════════════════════════════════════════════════════

         ⚠️ `web.frontend_layout` et NON `website.layout` : ce module ne dépend pas de
         `website`, et n'a pas à en dépendre. Le gabarit du module `web` charge déjà
         `web.assets_frontend` — donc le viewer 3D — et accepte `no_header` / `no_footer`.
         Y ajouter `website` amènerait ses menus, son éditeur et sa mise en page pour une
         page qui n'en veut aucun.

         ⓘ Le composant est monté par le service de composants publics d'Odoo 18 : il
         cherche les `<owl-component name="…">` de la page. Le JETON entre ici, par un
         prop, et ne ressort d'aucune réponse (D-190). -->
    <template id="configurator_page" name="3D product configurator">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <!-- ⓘ Le corps en COLONNE de la hauteur de l'écran : un bandeau ajouté en bas (base neutralisée)
                 prend sa ligne, la page le reste — sans seconde barre de défilement (D-498). -->
            <t t-set="body_classname" t-value="'o_cfg3d_body'"/>
            <div id="wrap">
                <!-- ⚠️ **L'ATTENTE COMMENCE AVANT OWL** : le composant ne peint qu'après son
                     `onWillStart` (plus d'une seconde sur un assemblage), et la page resterait
                     BLANCHE jusque-là. Ce tourniquet-ci est du HTML pur, présent dès le
                     premier octet.

                     ⓘ Il n'est pas caché par du JS : le composant se monte PAR-DESSUS,
                     avec un fond opaque. Rien à synchroniser, donc rien qui puisse
                     rester coincé si le montage échoue.

                     ⓘ La PHOTO du produit est là dès le premier octet : son adresse ne
                     demande que le jeton, déjà dans l'URL (D-566).
                     ⚠️ Le jeton est recopié, jamais résolu : la page est la même qu'il
                     existe ou non, et un jeton inconnu donne une image absente (D-190).
                     ⓘ Le décor reprend la scène du viewer, à la même place : la photo ne
                     bouge pas quand la page se monte par-dessus (D-566). -->
                <div class="o_cfg3d_boot">
                    <div class="o_cfg3d_boot_stage"
                         t-att-style="'background: %s' % stage_color if stage_color else None">
                        <!-- ⚠️ `eager` : sans attribut, `website` pose `loading="lazy"`, qui retarde la photo (D-566). -->
                        <img t-attf-src="/configurator/#{token}/image" alt="" loading="eager" fetchpriority="high"/>
                        <span class="o_cfg3d_spinner"/>
                    </div>
                    <div class="o_cfg3d_boot_side"/>
                </div>
                <owl-component name="product_configurator_web_3d.ConfiguratorPage"
                               t-att-props="props"/>
            </div>
        </t>
    </template>

</odoo>
