<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ══ LA MATIÈRE QU'UNE VALEUR DÉSIGNE, ET SA MINIATURE ═══════════════════
         Le pendant, côté matière, de ce que le cœur fait pour le produit (D-196) :
         `value_type` gouverne les colonnes de la liste des valeurs.

         ⚠️ Cette vue vit dans le PONT, pas dans le cœur. Le champ pointe une fiche
         de `product_editor` ; l'exposer depuis le cœur AGPL-3 le ferait dépendre de
         l'éditeur, l'inverse du sens que D-075 protège. -->
    <record id="product_attribute_view_form_material" model="ir.ui.view">
        <field name="name">product.attribute.form.material</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <!-- ⓘ La miniature D'ABORD : c'est elle qui sert à choisir — « la
                     miniature de la matière sert à la sélection de la matière ». Le nom
                     vient après, il confirme ce que l'œil a déjà décidé. -->
                <field
                    name="material_preview"
                    widget="image"
                    options="{'size': [45, 45]}"
                    class="oe_avatar text-start float-none"
                    column_invisible="parent.value_type != 'material'"
                    readonly="1"
                />
                <field
                    name="material_id"
                    column_invisible="parent.value_type != 'material'"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>

    <!-- La FICHE d'une valeur, ouverte depuis la liste ou le menu : sans elle, la
         matière ne se choisissait qu'en colonne — et pas du tout sur la fiche.
         C'est exactement ce que le taux au m² avait déjà coûté (D-162). -->
    <record id="product_attribute_value_form_material" model="ir.ui.view">
        <field name="name">product.attribute.value.form.material</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product_configurator_fa.product_attribute_value_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field
                    name="material_id"
                    invisible="value_type != 'material'"
                    options="{'no_create': True}"
                />
                <field
                    name="material_preview"
                    widget="image"
                    options="{'size': [90, 90]}"
                    invisible="value_type != 'material'"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>

    <!-- ══ LA VIGNETTE D'UNE VALEUR EN CARTE ══════════════════════════════════
         ⓘ Ces vues sont ICI, et non dans `product_attribute_advanced`, pour la
         même raison que le type lui-même : elles ne servent qu'à la forme que
         ce module dessine (D-258, arbitré le 2026-09-06).
         Odoo ne montre le champ `image` d'une valeur QUE pour le type
         « couleur » — c'est le seul de ses cinq types qui affiche une image.
         Une carte en affiche une aussi : sans cette levée, l'attribut réglé en
         carte n'offre AUCUN moyen de téléverser sa vignette, et la hiérarchie de
         `_preview_source()` n'a plus de premier maillon atteignable.
         ⓘ On ÉLARGIT la condition d'origine plutôt que de la remplacer : le
         comportement pour « couleur » ne bouge pas d'un pixel. -->
    <record id="product_attribute_view_form_card_image" model="ir.ui.view">
        <field name="name">product.attribute.form.card.image</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/list/field[@name='image']"
                   position="attributes">
                <attribute name="column_invisible">parent.display_type not in ('color', 'card')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Et là où la valeur de VARIANTE se lit : la même image, la même règle. -->
    <record id="product_template_attribute_value_tree_card_image" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.card.image</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <field name="image" position="attributes">
                <attribute name="invisible">display_type not in ('color', 'card')</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_attribute_value_form_card_image" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.card.image</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="image" position="attributes">
                <attribute name="invisible">display_type not in ('color', 'card') or not image</attribute>
            </field>
        </field>
    </record>

</odoo>
