<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Product Attributes -->
    <record id="product_attribute_tree_view" model="ir.ui.view">
        <field name="name">product.config.product.attribute.tree</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.attribute_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="search_ok" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="product_attribute_form_view">
        <field name="name">product.attribute.form.view</field>
        <field name="model">product.attribute</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//group[@name='main_fields']" position="before">
                <!-- ⚠️ PLUS DE `flag_config_ok` ICI, NI PLUS BAS (A1, 2026-08-28).
                     On peut cacher par DROIT ou par CHEMIN. Le droit est une propriété du
                     LECTEUR ; le chemin n'est qu'un accident de navigation — et c'est ce que
                     ce drapeau faisait : posé par le menu du configurateur et par la ligne
                     d'un produit configurable, absent du menu standard « Configuration →
                     Attributs ». Le MÊME enregistrement montrait donc des informations
                     différentes selon la porte empruntée, et un gestionnaire arrivé par la
                     porte standard ne voyait rien — pas même de quoi désarchiver.
                     Les pages ci-dessous portent déjà leur groupe : le droit suffit.
                     Constat de Gerry : « on est obligé d'aller dans configurateur pour voir
                     les informations supplémentaires des attributs ». -->
                <field
                    name="image"
                    widget="image"
                    class="oe_avatar oe_left"
                >
                    <field name="image" widget="image" class="oe_avatar oe_left" />
                </field>
                <!-- ══ LE NOM DEVIENT LE TITRE — maquette de Gerry ═════════════════
                     ⓘ Il était un champ parmi d'autres dans le premier groupe. Sur sa
                     maquette il ouvre la page, comme le nom d'un produit : c'est ce
                     qu'on lit en arrivant, et ce dont tout le reste parle. -->
                <div class="oe_title">
                    <label for="name" string="Attribute" class="oe_edit_only" />
                    <h1><field name="name" placeholder="e.g. Colour" /></h1>
                </div>
            </xpath>

            <!-- ⚠️ `create_variant` N'EST PLUS CACHÉ DERRIÈRE LE MODE DÉVELOPPEUR.
                 Constat de Gerry (2026-08-28) : « je ne vois pas dans l'attribut la
                 gestion des variants ». Le `groups="base.group_no_one"` est arrivé avec
                 le renommage en masse du fork OCA, sans raison consignée — et il
                 contredit une règle que le fork a écrite depuis.

                 ⓘ CE CHAMP N'EST PAS DÉCORATIF. `_resolves_to_values()` s'appuie sur lui :
                 *« un nombre saisi sur cet attribut se range-t-il en valeur d'attribut ?
                 La question n'a pas besoin d'un champ neuf : `create_variant` la porte
                 déjà. En `no_variant`, la valeur ne peut pas entrer dans l'identité d'une
                 variante […] et c'est tout l'objet de D-081 : le stock ne sait distinguer
                 deux portes que par leurs valeurs d'attribut. »* Il décide donc si une
                 saisie du client devient une valeur PERSISTÉE — un comportement majeur,
                 réglable jusqu'ici seulement en mode développeur.

                 Mesuré sur `fabk18` : 7 attributs en `always`, 3 en `no_variant`. Le
                 réglage VARIE déjà, sans que personne puisse le voir.

                 Il reste à sa place d'origine, auprès du type d'affichage : c'est une
                 propriété du cœur, et le cœur la protège déjà d'un changement tardif
                 (`readonly` dès qu'un produit emploie l'attribut). -->
            <!-- ─ A3 : DANS LE CORPS DE LA FICHE, PAS DANS UN ONGLET ────────────
                 Arbitrage de Gerry (2026-08-28) : *« je ne veux pas de l'onglet
                 configurator, je voudrais que les éléments viennent à la suite avant
                 les valeurs. »*

                 ⓘ Et c'est plus juste : ces réglages décrivent l'attribut LUI-MÊME,
                 au même titre que son nom et son type d'affichage. Un onglet les
                 rangeait à côté des VALEURS, qui sont autre chose — et il fallait un
                 clic pour savoir ce qu'un attribut est.

                 « Du commun au spécifique » : Description · Ce qu'une valeur est ·
                 Défauts pour une nouvelle ligne — puis les valeurs, dans leur onglet.

                 ⚠️ LE GROUPE DE DROITS DESCEND SUR CHAQUE BLOC. Il vivait sur la page ;
                 la page partie, l'oublier aurait montré ces réglages à tout le monde —
                 un élargissement de droits par déménagement. -->
            <!-- ══ LES DÉFAUTS REMONTENT SOUS LE TITRE — maquette de Gerry ═════
                 Ils ne décident de rien par eux-mêmes (A4) : c'est la ligne, sur le
                 produit, qui est lue à la configuration. Mais ce sont les trois
                 réglages qu'on veut voir d'un coup d'œil en ouvrant un attribut. -->
            <!-- ⚠️ LE NOM NE S'AFFICHE QU'UNE FOIS. Il est devenu le TITRE de la
                 page ; le champ du cœur, resté dans son groupe, le répétait juste
                 en dessous — « Marque » deux fois, à deux endroits de la même page.
                 Constat de Gerry.

                 ⓘ On MASQUE au lieu de supprimer : `name` est requis, et d'autres
                 modules visent ce nœud. Le retirer casserait leurs `xpath` ; le
                 masquer ne casse rien et suffit ([[L-167]]). -->
            <xpath expr="//group[@name='sale_main_fields']/label[@for='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_main_fields']/field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ⓘ `active`, puis le filtre e-commerce, puis « recherchable » :
                 l'ordre demandé par Gerry. `search_ok` quitte « ce qu'une valeur
                 est » — il ne dit pas ce qu'une valeur EST, il dit si l'attribut
                 entre dans la recherche d'une variante identique. -->
            <!-- ⚠️ LA COLONNE DE DROITE, autant qu'un module qui NE DÉPEND PAS de
                 `website_sale` peut le faire. Gerry demande « actif, eCommerce,
                 recherchable » empilés à droite. Les deux qui nous appartiennent y
                 vont ; le **filtre e-commerce** vit dans `ecommerce_main_fields`, un
                 groupe de `website_sale` — l'y rejoindre demanderait de viser ce
                 groupe, et l'xpath échouerait partout où ce module n'est pas installé
                 (vérifié : il ne l'est pas sur la base de démo).

                 ⓘ Le rangement strict des trois demanderait donc une dépendance à
                 `website_sale` — toute la pile site web sur chaque base du
                 configurateur. Signalé à Gerry plutôt que décidé seul.

                 ⓘ `search_ok` quitte « ce qu'une valeur est » : il ne dit pas ce
                 qu'une valeur EST, il dit si l'attribut entre dans la recherche
                 d'une variante identique. -->
            <!-- ══ LE MODE DE PRIX REJOINT L'IDENTITÉ — demande de Gerry ══════════
                 ⚠️ **ET IL RESTE UNE SEMENCE, malgré ce que sa place suggère.**
                 Gerry le déplace en le disant *« uniquement dans l'attribut »* ;
                 mesuré, il existe sur QUATRE modèles, et ce qui est lu à l'exécution
                 est `attribute_line_id.price_mode` — **la ligne** —, en trois
                 endroits du code. Comme `required`, `multi` et `val_custom`, il est
                 recopié sur la ligne à sa création et n'est plus consulté ensuite.

                 ⓘ Le sortir du bloc « Defaults » et lui retirer le préfixe lui ôte
                 les deux signaux qui le disaient. C'est le choix de Gerry, consigné
                 avec la mesure ; le `help` du champ, lui, reste exact. -->
            <xpath expr="//group[@name='sale_main_fields']/field[@name='create_variant']" position="after">
                <field name="price_mode" string="Extra price mode" />
            </xpath>

            <xpath expr="//group[@name='sale_main_fields']" position="after">
                <group name="attribute_flags">
                    <field name="active" />
                    <field name="search_ok" />
                </group>
            </xpath>

            <xpath expr="//group[@name='main_fields']" position="after">
                <group
                    string="Defaults for a new product line"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <!-- ⚠️ EN CASES ALIGNÉES, comme la maquette : trois drapeaux
                         courts se lisent d'un coup d'œil, là où deux colonnes de
                         formulaire les faisaient ressembler à des réglages de fond.
                         ⓘ Et leurs libellés perdent le préfixe « Default: » — le
                         TITRE du bloc le dit maintenant, le répéter quatre fois
                         alourdissait sans rien apprendre (A4). -->
                    <div colspan="2" class="d-flex flex-wrap gap-4">
                        <span class="d-inline-flex align-items-center gap-1">
                            <field name="required" string="Required" />
                            <label for="required" string="Required" />
                        </span>
                        <!-- ⚠️ PLUS DE VERROU CROISÉ entre « Multi » et « Allow add ».
                             Question de Gerry : *« si l'attribut autorise l'ajout, il ne
                             peut pas être multi ? »*. Vérifié : **aucune contrainte de
                             modèle ne l'interdisait** — deux `readonly` croisés dans la
                             vue, hérités du fork OCA, sans raison consignée.

                             ⓘ Et l'assistant prévoit EXPLICITEMENT la combinaison :
                             `if field_type == "many2many": field_val = [(6, False,
                             [custom_option_id])]`. Cette branche n'existerait pas si
                             les deux s'excluaient. Le verrou rendait donc inatteignable
                             un cas que le moteur sait traiter — la famille du taux au
                             m² (D-162), « complet et inatteignable ».

                             ⓘ `force_save` part avec lui : il n'existait que parce
                             qu'un champ en lecture seule n'est pas enregistré. -->
                        <span class="d-inline-flex align-items-center gap-1">
                            <field name="multi" />
                            <label for="multi" string="Multi" />
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <field name="val_custom" />
                            <label for="val_custom" string="Allow add" />
                        </span>
                    </div>
                </group>
            </xpath>

            <!-- ══ TOUT LE RESTE ENTRE DANS « INFORMATIONS GÉNÉRALES » ═════════
                 Instruction de Gerry : *« insère toutes les informations dans
                 informations générales »*. La page cesse d'être une pile de blocs
                 de même rang — identité et nature d'un côté, valeurs de l'autre.

                 ⚠️ LE GROUPE DE DROITS DESCEND SUR CHAQUE BLOC, et non sur la page :
                 un droit posé sur l'onglet cacherait l'onglet entier, alors que
                 certains de ses blocs doivent rester visibles.

                 ⓘ La page est insérée AVANT celle des valeurs : on lit ce qu'un
                 attribut EST avant d'énumérer ce qu'il propose. -->
            <xpath expr="//page[@name='attribute_values']" position="before">
                <page string="General information" name="general_information">
                    <!-- ⚠️ ON DÉPLACE LE GROUPE DU CŒUR, ON NE LE RECOPIE PAS.
                         Premier essai : le cacher et réécrire ses champs ici. Le
                         résultat était juste à l'écran et FAUX en profondeur —
                         `website_sale` ajoute son filtre e-commerce **dans** ce
                         groupe (`ecommerce_main_fields`), et la copie l'a fait
                         disparaître. Constat de Gerry : *« tu as oublié le filtre
                         e-commerce »*.

                         ⓘ `position="move"` relocalise le nœud existant : tout ce
                         que d'autres modules y ont greffé suit, aujourd'hui comme
                         demain. Et le fork n'a pas à connaître `website_sale`, dont
                         il ne dépend pas — il ne pourrait de toute façon pas nommer
                         son champ ([[L-167]]). -->
                <!-- ══ CE QU'UNE VALEUR EST — deux colonnes, D-218 ═══════════════
                     Demande de Gerry : à gauche le type, le format et l'unité, plus
                     une coche « valeurs dynamiques » quand la valeur désigne un
                     produit ; à droite le filtre — et seulement si la coche est mise.

                     ⚠️ `custom_type` a QUITTÉ la page « Custom Values », où il était
                     masqué tant que la saisie libre n'était pas cochée : une épaisseur
                     énumérée 10 / 15 / 18 n'avait AUCUN format déclaré, alors que la
                     grille de prix et le moteur de géométrie lisent ces valeurs comme
                     des nombres. -->
                <!-- ⚠️ UN SÉPARATEUR, ET NON UN TITRE DE GROUPE. Constat de Gerry :
                     *« arrête le sous-lignage à moitié pour que Dynamic values soit à
                     la même hauteur »*. Un `<group string="…">` imbriqué souligne sa
                     PROPRE colonne — d'où un trait à mi-page, et un décalage : le
                     titre du groupe de droite descendait d'une ligne par rapport à la
                     première du groupe de gauche.

                     ⓘ Le séparateur, lui, traverse les deux colonnes ; les deux
                     sous-groupes commencent alors à la même hauteur. -->
                <separator name="value_types" string="Value types" colspan="2" />
                <group
                    name="value_nature_block"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <group name="value_nature">
                        <field name="value_type" />
                        <!-- ⚠️ LE FORMAT ET L'UNITÉ NE VALENT QUE POUR LE TYPE
                             « VALEUR » : un format dit comment LIRE un libellé, et
                             quand la valeur désigne un produit, l'objet EST la
                             réponse. Le modèle refuse aussi la combinaison (D-194). -->
                        <field
                            name="custom_type"
                            string="Format"
                            invisible="value_type != 'value'"
                        />
                        <field
                            name="uom_id"
                            invisible="value_type != 'value' or custom_type not in ['integer', 'float']"
                        />
                        <!-- ⓘ Le MODE des valeurs : tenues à la main, ou proposées par
                             un filtre. Réservé au type « produit » (QK) — une condition
                             vérifie l'égalité sur des produits, et un filtre ne sait
                             proposer que cela. -->
                        <field
                            name="dynamic_values"
                            invisible="value_type != 'product'"
                        />
                    </group>

                    <!-- ⚠️ LE FILTRE N'APPARAÎT QUE SOUS LA COCHE. Sans elle, il
                         laissait croire que toute liste de produits était dynamique,
                         alors que les deux régimes coexistent : soit on TIENT la
                         liste, soit un filtre la PROPOSE et la liste devient la trace
                         de ce qui a été choisi (QJ). -->
                    <group
                        string="Dynamic values"
                        name="product_filter"
                        class="o_config_filter_group"
                        invisible="value_type != 'product' or not dynamic_values"
                    >
                        <field
                            name="product_filter_domain"
                            widget="domain"
                            options="{'model': 'product.product'}"
                            nolabel="1"
                            colspan="2"
                        />
                        <!-- ⚠️ CE QUE LE FILTRE DONNE, AVANT DE S'EN SERVIR (D-208) :
                             un domaine est une promesse tant qu'on ne l'a pas appliqué,
                             et sans retour il se vérifie devant le client. -->
                        <field name="product_filter_count" invisible="1" />
                        <button
                            name="action_open_proposed_products"
                            type="object"
                            icon="fa-search"
                            class="btn-link ps-0"
                            colspan="2"
                            string="See the products found"
                            invisible="not product_filter_count"
                        />
                        <div colspan="2" class="text-muted" invisible="product_filter_count">
                            No product matches this filter yet.
                        </div>
                    </group>
                </group>

                <group
                    name="attribute_description"
                    string="Description"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <field name="description" nolabel="1" colspan="2" />
                </group>

                <!-- ─ DÉFAUTS : ce dont héritera la ligne d'un NOUVEAU produit ──
                     ⚠️ Ces quatre-là ne décident de rien par eux-mêmes : c'est la ligne,
                     sur le produit, qui est lue à la configuration. Le titre du bloc le
                     dit, faute de quoi la page ferait croire à des réglages actifs — ce
                     qu'elle a fait jusqu'ici. -->
                </page>
            </xpath>

            <!-- ⚠️ LE DÉPLACEMENT EST UNE SPEC À PART, et ce n'est pas un détail de
                 style : `position="move"` n'est traité que pour un ENFANT DIRECT de
                 la spec qui le contient (`template_inheritance.py`). Niché dans la
                 page créée juste au-dessus, il était petit-enfant — et Odoo l'a
                 ignoré en silence, sans erreur ni avertissement. Le groupe restait
                 en tête de page, et rien ne le disait.

                 ⓘ Il vient donc APRÈS l'ajout de la page : les specs d'une même vue
                 s'appliquent dans l'ordre du document, donc la page existe. -->
            <!-- ⚠️ L'ANCRE DU DÉPLACEMENT A SUIVI LA MISE EN PAGE. Elle visait le
                 bloc « Description », qui est passé TOUT EN BAS sur demande de
                 Gerry : l'identité aurait donc atterri en fin de page, sous la
                 description. Elle vise maintenant le bloc de nature, qui ouvre
                 l'onglet. -->
            <!-- ⚠️ L'ANCRE VISE LE SÉPARATEUR, pas le groupe qui le suit. Elle a
                 déjà dû suivre la mise en page une fois (le bloc « Description »
                 est passé en bas) ; ici, viser le groupe plaçait l'identité APRÈS
                 le titre « Value types », qui se retrouvait en tête d'onglet. -->
            <xpath expr="//separator[@name='value_types']" position="before">
                <xpath expr="//group[@name='main_fields']" position="move" />
            </xpath>

        </field>
    </record>

    <record model="ir.actions.act_window" id="action_attributes_view">
        <field name="name">Attributes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_attribute_action_configuration"
        action="action_attributes_view"
        parent="menu_product_configurable_settings"
        sequence="10"
        groups="product.group_product_variant"
    />

    <!-- Product Attribute Value -->
    <record
        id="product_template_attribute_value_view_tree_weight_extra"
        model="ir.ui.view"
    >
        <field
            name="name"
        >product.template.attribute.value.view.tree.weight.extra</field>
        <field name="model">product.template.attribute.value</field>
        <field
            name="inherit_id"
            ref="product.product_template_attribute_value_view_tree"
        />
        <field name="type">list</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_extra']" position="after">
                <field
                    name="weight_extra"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                />
            </xpath>
        </field>
    </record>

    <record
        id="product_template_attribute_value_view_form_weight_extra"
        model="ir.ui.view"
    >
        <field
            name="name"
        >product.template.attribute.value.view.form.weight.extra</field>
        <field name="model">product.template.attribute.value</field>
        <field
            name="inherit_id"
            ref="product.product_template_attribute_value_view_form"
        />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_extra']" position="before">
                <field
                    name="weight_extra"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                />
            </xpath>
        </field>
    </record>

    <!-- Product Attribute Value -->
    <record id="product_attribute_value_list" model="ir.ui.view">
        <field name="name">product.attribute.value.list.inherit</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="attribute_id" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="product_attribute_value_form_view">
        <field name="name">product.config.product.attribute.value.form.view</field>
        <field name="model">product.attribute.value</field>
        <field name="arch" type="xml">
            <form string="Product Attribute Values">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" />
                    <div class="oe_left" style="width: 500px;">
                        <div class="oe_title" style="width: 390px;">
                            <label class="oe_edit_only" for="name" string="Value" />
                            <h1>
                                <field name="name" class="oe_inline" />
                            </h1>
                            <label for="active" />
                            <field name="active" />
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="attribute_id" />
                        </group>
                        <group>
                            <field name="value_type" invisible="1" />
                            <!-- ⚠️ Le produit était offert à TOUS les types, y compris
                                 à ceux dont une valeur ne désigne qu'elle-même. La
                                 même règle qu'en liste (D-196), sur la fiche. -->
                            <field
                                name="product_id"
                                invisible="value_type != 'product'"
                                options="{'no_create': True}"
                            />
                            <field name="currency_id" invisible="1" />
                            <field
                                name="product_price"
                                widget="monetary"
                                invisible="value_type != 'product'"
                                readonly="1"
                            />

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="variants_action" model="ir.actions.act_window">
        <field name="name">Attribute Values</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.attribute.value</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_variants_action_configuration"
        action="variants_action"
        parent="menu_product_configurable_settings"
        sequence="20"
        groups="product.group_product_variant"
    />

    <!-- ⚠️ LE TAUX AU m² N'ÉTAIT SAISISSABLE NULLE PART. Le champ existait, ses
         tests passaient — et aucun écran ne le portait : la fonctionnalité était
         complète et inatteignable (D-162). Deux vues le réparent : le catalogue
         (la valeur d'attribut, qui porte le défaut) et le produit (la valeur du
         template, qui peut le surcharger). -->
    <record id="product_attribute_view_form_sqm" model="ir.ui.view">
        <field name="name">product.attribute.form.sqm</field>
        <!-- ⚠️ Le modèle est celui de la vue PARENTE (`product.attribute`), pas
             celui de la liste qu'on complète : la colonne vit à l'intérieur du
             `value_ids`, la vue héritée reste celle de l'attribut. -->
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <!-- ⚠️ UN SEUL MONTANT, ET EN FIN DE LIGNE. Constat de Gerry :
                 « default_extra_price ne peut pas être visible en même temps que
                 default_extra_price_sqm, c'est l'un ou l'autre en fin de ligne ».

                 ⚠️ Et ce n'est PAS cosmétique. Le module le dit lui-même à propos du
                 taux : « Odoo somme `price_extra` partout, et y ranger 25 €/m² le
                 ferait facturer 25 € ». Les deux champs côte à côte invitent à
                 remplir les deux — et le montant fixe serait alors facturé EN PLUS
                 du mètre carré, sans erreur et sans trace.

                 ⓘ Le mode de l'attribut n'est qu'une SEMENCE (A4) : c'est la ligne
                 du produit qui décide. Masquer par lui reste juste, parce qu'une
                 ligne n'a qu'un seul mode — on sème donc le mode ET le montant qui
                 lui correspond, jamais l'autre. -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='default_extra_price']" position="attributes">
                <!-- ⚠️ Le montant saisissable s'efface pour un attribut de type produit :
                     il n'est JAMAIS appliqué à ces valeurs — le prix du produit l'est —,
                     et un nombre modifiable qui ne sert à rien est exactement ce que
                     Gerry veut éviter : « ça peut être trompeur et fausser les prix »
                     (D-199). Le prix du produit prend sa place, en lecture. -->
                <attribute name="column_invisible">parent.price_mode == 'per_sqm' or parent.value_type == 'product'</attribute>
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='default_extra_price']" position="after">
                <field name="currency_id" column_invisible="True" />
                <!-- ⚠️ VISIBLE DANS LES DEUX MODES DE PRIX, et ce n'est pas un oubli :
                     le prix du produit est facturé quel que soit le mode — le code qui
                     le calcule ne le consulte pas. Il est donc le SEUL montant d'une
                     valeur-produit, dans les deux modes. -->
                <field
                    name="product_price"
                    widget="monetary"
                    column_invisible="parent.value_type != 'product'"
                    readonly="1"
                />
                <!-- ⚠️ LE TAUX AU m² NE CONCERNE PAS UN PRODUIT. Arbitrage de Gerry
                     (2026-08-28) : « pour un produit, seule la ligne de plus-value
                     unitaire remplacée par le prix du produit est visible ; c'est
                     uniquement la matière qui peut appliquer un prix au mètre carré
                     ou unitaire suivant le choix de l'attribut ».

                     ⓘ Cela ferme la question laissée ouverte : un attribut de type
                     produit sur une ligne au m² montrait DEUX montants. Il n'en montre
                     plus qu'un — celui du produit, le seul qui vaille. -->
                <field
                    name="default_extra_price_sqm"
                    column_invisible="parent.price_mode != 'per_sqm' or parent.value_type == 'product'"
                />
            </xpath>
        </field>
    </record>

    <!-- ══ CE QUE `value_type` GOUVERNE DANS LA LISTE DES VALEURS (D-196) ══════
         Constat de Gerry : « l'affichage des champs de liste des valeurs d'attribut
         est influencé par le type d'affichage, mais il est influencé aussi par Value
         type ». Deux axes commandaient cette liste, et un seul était câblé.

         ⚠️ LES DEUX AXES RESTENT INDÉPENDANTS DANS LEUR CHOIX. `display_type` dit
         comment on CHOISIT (pastilles, liste déroulante, cases) ; `value_type` dit ce
         que la valeur DÉSIGNE. Un attribut de type « matière » affiché en `select` est
         parfaitement légitime. Les coupler serait refaire l'erreur du format (D-194)
         dans l'autre sens : ils gouvernent des colonnes différentes, pas les mêmes. -->
    <record id="product_attribute_view_form_value_type" model="ir.ui.view">
        <field name="name">product.attribute.form.value.type</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <!-- La liste lit `parent.value_type` : il doit être dans la vue parente,
                 et il y est (groupe « What a value is »). -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field
                    name="product_id"
                    column_invisible="parent.value_type != 'product'"
                    options="{'no_create': True}"
                />
            </xpath>

            <!-- ⚠️ « Texte libre » QUITTE LA COLONNE. Constat de Gerry : « il y a déjà
                 Default: customer may add a value, donc texte libre n'a pas d'intérêt
                 en colonne ».

                 ⓘ Ce que la mesure a montré, et qu'il faut savoir : les deux drapeaux
                 ne servent PAS le même configurateur. `val_custom` (attribut) est celui
                 que NOTRE assistant lit — `self.custom = self.attribute_id.val_custom`.
                 `is_custom` (valeur) n'est lu nulle part dans le fork : il n'est lu que
                 par le configurateur NATIF d'Odoo et par `website_sale`. Le masquer ne
                 retire donc rien à nos produits configurables ; il retire le seul écran
                 où l'on réglait la saisie libre native, pour un produit qui n'est pas
                 `config_ok`. Une ligne à remettre si le besoin s'en présente. -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='is_custom']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <!-- La pastille et la vignette ne valent que pour une valeur qui ne désigne
                 QU'ELLE-MÊME : un produit a son image, une matière a sa miniature PBR.
                 ⓘ La condition du core sur `display_type` est CONSERVÉE et complétée —
                 les deux axes s'ajoutent, aucun ne remplace l'autre. -->
            <xpath expr="//field[@name='value_ids']/list/field[@name='html_color']" position="attributes">
                <attribute name="column_invisible">parent.display_type != 'color' or parent.value_type != 'value'</attribute>
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='image']" position="attributes">
                <attribute name="column_invisible">parent.display_type != 'color' or parent.value_type != 'value'</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_attribute_value_view_tree_sqm" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.sqm</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree" />
        <field name="arch" type="xml">
            <!-- ⚠️ MÊME RÈGLE QUE SUR LE CATALOGUE, mais PAR LIGNE et non par
                 colonne : `price_mode` est lié à la ligne d'attribut, et cette liste
                 peut mêler des lignes de modes différents. `column_invisible` ne
                 s'évalue que sur le contexte parent — seul `invisible`, évalué par
                 enregistrement, sait vider la bonne cellule.

                 ⚠️ Le montant fixe DISPARAÎT en mode m², il ne devient pas seulement
                 lecture seule : un zéro affiché à côté d'un taux se lit comme « pas
                 de supplément », alors qu'il y en a un — et un champ modifiable
                 aurait invité à le remplir, ce qu'Odoo aurait facturé en plus. -->
            <xpath expr="//field[@name='price_extra']" position="attributes">
                <!-- ⚠️ Une valeur qui désigne un PRODUIT est facturée au prix de ce
                     produit : son `price_extra` est ignoré par le calcul. Le montrer
                     ici serait le même mensonge que dans le catalogue (D-199). -->
                <attribute name="invisible">price_mode == 'per_sqm' or value_type == 'product'</attribute>
            </xpath>
            <!-- ══ CE QUE LE RETRAIT FERA — B4, QC, D-205 ═══════════════════════
                 « Si aucun variant n'a été créé on peut supprimer ; s'il y a déjà eu
                 des variants on désactive. » Le cœur le fait déjà ; ce qui manquait
                 était de le DIRE avant le clic — un bouton, deux effets, décidés par
                 un état que l'utilisateur ne voit pas. -->
            <xpath expr="//field[@name='price_extra']" position="before">
                <field name="removal_effect" widget="badge" optional="show" />
            </xpath>
            <xpath expr="//field[@name='price_extra']" position="after">
                <field name="price_mode" column_invisible="True" />
                <field name="value_type" column_invisible="True" />
                <field name="currency_id" column_invisible="True" />
                <field
                    name="product_price"
                    widget="monetary"
                    invisible="value_type != 'product'"
                    readonly="1"
                />
                <field
                    name="price_extra_sqm"
                    widget="monetary"
                    options="{'field_digits': True}"
                    column_invisible="context.get('hide_sqm', False)"
                    invisible="price_mode != 'per_sqm' or value_type == 'product'"
                />
            </xpath>
        </field>
    </record>

    <record id="product_attribute_value_form_sqm" model="ir.ui.view">
        <field name="name">product.attribute.line.value.form.sqm</field>
        <field name="model">product.template.attribute.line</field>
        <field name="inherit_id" ref="product.product_template_attribute_line_form" />
        <field name="arch" type="xml">
            <!-- Le formulaire d'une VALEUR, ouvert depuis la liste : sans lui, le
                 taux ne se voyait qu'en colonne, et pas du tout sur la fiche. -->
            <xpath expr="//field[@name='value_ids']/form/field[@name='name']" position="after">
                <field name="price_mode" invisible="1" />
                <field
                    name="default_extra_price_sqm"
                    invisible="price_mode != 'per_sqm'"
                />
                <!-- ⓘ Le montant fixe n'est PAS sur cette fiche (le core ne l'y met
                     pas) : il n'y a donc rien à masquer ici, et rien qui contredise
                     le taux. Noté pour qu'un lecteur ne cherche pas la symétrie. -->
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="price_mode" column_invisible="True" />
                <field
                    name="default_extra_price_sqm"
                    column_invisible="parent.price_mode != 'per_sqm'"
                />
            </xpath>
        </field>
    </record>

    <record id="product_template_attribute_value_form_sqm" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.sqm</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form" />
        <field name="arch" type="xml">
            <!-- La même exclusivité que dans la liste : sur la fiche aussi, un seul
                 des deux montants a un sens, et le fixe se facturerait EN PLUS. -->
            <xpath expr="//field[@name='price_extra']" position="attributes">
                <attribute name="invisible">price_mode == 'per_sqm' or value_type == 'product'</attribute>
            </xpath>
            <xpath expr="//field[@name='price_extra']" position="after">
                <field name="price_mode" invisible="1" />
                <field name="value_type" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field
                    name="product_price"
                    widget="monetary"
                    invisible="value_type != 'product'"
                    readonly="1"
                />
                <field
                    name="price_extra_sqm"
                    widget="monetary"
                    options="{'field_digits': True}"
                    invisible="price_mode != 'per_sqm'"
                />
            </xpath>
        </field>
    </record>

    <!-- Product Attribute Line -->
    <record id="product_template_attribute_line_form_config" model="ir.ui.view">
        <field name="name">product.template.attribute.line.form</field>
        <field name="model">product.template.attribute.line</field>
        <field name="inherit_id" ref="product.product_template_attribute_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_field']" position="after">
                <field name="attribute_custom_type" invisible="1" />
                <group name="configurator_pricing" string="Configurator">
                    <field name="dimension_role" />
                    <field name="price_mode" />
                    <field name="visibility_domain_id" />
                </group>
                <group
                    name="bounds"
                    string="Bounds"
                    invisible="attribute_custom_type not in ['integer', 'float']"
                >
                    <group>
                        <label for="min_val" />
                        <div class="o_row">
                            <field name="has_min_val" />
                            <field name="min_val" invisible="not has_min_val" />
                        </div>
                        <label for="max_val" />
                        <div class="o_row">
                            <field name="has_max_val" />
                            <field name="max_val" invisible="not has_max_val" />
                        </div>
                        <field name="step" />
                    </group>
                    <field name="bound_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="domain_id" />
                            <field name="has_min_val" />
                            <field name="min_val" readonly="not has_min_val" />
                            <field name="has_max_val" />
                            <field name="max_val" readonly="not has_max_val" />
                            <field name="step" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
