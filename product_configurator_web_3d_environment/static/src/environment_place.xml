<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Le produit posé dans une baie, sous le titre du panneau de l'ouverture (étape 8.4c). ⓘ Le panneau est
         un gabarit à part depuis W-113 (E-2d) : rendu dans la barre latérale ou dans le panneau bas. -->
    <t t-inherit="product_editor_environment.EnvironmentPanel" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='opening']/h5" position="after">
            <t t-set="placed" t-value="placementOf(opening.id)"/>
            <div t-if="placed" class="o_env_placed alert alert-info small py-2">
                <div class="text-muted">Placed product</div>
                <strong t-esc="placed.productName"/>
                <!-- ⓘ L'écart que le produit garde quand la baie change (D-424). -->
                <div t-if="offsetLabel(placed, 'width')">Width: <t t-esc="offsetLabel(placed, 'width')"/></div>
                <div t-if="offsetLabel(placed, 'height')">Height: <t t-esc="offsetLabel(placed, 'height')"/></div>
            </div>
            <button t-if="state.canPlace and !readonly" type="button"
                    class="btn btn-sm btn-light mb-2" t-on-click="() => this.openChooser(opening.id)">
                <i class="fa fa-th me-1"/><t t-if="placed">Change the product</t><t t-else="">Choose a product</t>
            </button>
        </xpath>
    </t>

    <!-- CONFIGURER dans l'environnement (étape 8.4e) : la page du configurateur, en panneau seul, est la barre de
         DROITE d'un produit posé sélectionné (W-113, E-3b) — ses réponses s'affichent comme des attributs ; sa
         flèche ramène à l'environnement. -->
    <t t-inherit="product_editor_environment.EnvironmentRightPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_env_right')]" position="before">
            <t t-set="configured" t-value="configuringPlacement"/>
            <div t-if="configured" class="o_env_right o_env_configure ce-sidebar"
                 t-att-class="{ 'o_env_right--sheet': state.isSmall }">
                <ConfiguratorPage t-key="configured.token + ':' + state.configureSerial" token="configured.token"
                                  closable="false" panelOnly="true"
                                  onBack="() => this.stopConfiguring()"
                                  onScene="(group) => this.onPlacedScene(configured.openingId, configured.token, group)"/>
            </div>
        </xpath>
    </t>

    <t t-inherit="product_editor_environment.EnvironmentEditor" t-inherit-mode="extension">
        <!-- Le produit posé se MONTRE (étape 8.4d) : la page du configurateur construit hors de
             l'écran, et rend une copie de sa scène. ⚠️ Hors de l'écran, pas masquée : un viewer de
             taille nulle n'a rien à copier. -->
        <xpath expr="//ProductChooser" position="after">
            <t t-set="job" t-value="placementToRender"/>
            <div t-if="job" class="o_env_render_stage" aria-hidden="true"
                 style="position:fixed;left:-10000px;top:0;width:960px;height:720px;overflow:hidden;pointer-events:none">
                <ConfiguratorPage t-key="job.token" token="job.token" closable="false"
                                  onScene="(group) => this.onPlacedScene(job.openingId, job.token, group)"/>
            </div>
        </xpath>
    </t>

</templates>
