<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_config_inherited" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="priority">16</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- ⚠️ CONSERVÉ malgré la case ci-dessous. Ce champ caché sert au bouton
                     « Configure Product », qui vit dans l'AUTRE vue (`product_template_only_
                     form_view`) : l'y retirer parce qu'il fait doublon ICI casserait son
                     `invisible="not config_ok"` là-bas. -->
                <field name="config_ok" invisible="1" />
            </xpath>

            <!-- « Peut être configuré », à la suite de « Peut être vendu » et « Peut être
                 acheté » — demande de Gerry (2026-08-27), en remplacement du bouton
                 d'action qui vivait dans la boîte à boutons.

                 ⓘ Même patron que le cœur : `account` ajoute « Peut être acheté » par un
                 `<div name="options" position="inside">` sur cette même vue. Sa priorité
                 est 5, celle-ci 16 : l'ordre d'affichage suit donc les priorités, sans
                 rien à coordonner.

                 ⚠️ Le GROUPE est celui du bouton qu'on remplace. Sans lui, n'importe quel
                 utilisateur rendrait un produit configurable — un droit que la boîte à
                 boutons réservait au gestionnaire, et qu'une case ne doit pas élargir au
                 passage. -->
            <div name="options" position="inside">
                <span
                    class="d-inline-flex"
                    groups="product_configurator_fa.group_product_configurator_fa_manager"
                >
                    <field name="config_ok" />
                    <label for="config_ok" />
                </span>
            </div>
        </field>
    </record>

    <record id="product_template_only_form_view_inherited" model="ir.ui.view">
        <field name="name">product.configurator.product.template.form</field>
        <field name="model">product.template</field>
        <field name="priority">16</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr='//header' position="inside">
                <button
                    name="configure_product"
                    class="oe_highlight"
                    type="object"
                    string="Configure Product"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    invisible="not config_ok"
                />
            </xpath>
            <!-- ⓘ Le bouton d'action « Configurable » de la boîte à boutons a été RETIRÉ
                 (Gerry, 2026-08-27) : la case à cocher de la vue commune le remplace, à côté
                 de « Peut être vendu » et « Peut être acheté ». Un état booléen se lit mieux
                 dans une case que dans un bouton qui dit tantôt « Configurable », tantôt
                 « Standard ».

                 ⚠️ La MÉTHODE `toggle_config`, elle, RESTE : elle est publique, couverte par
                 `test_03_toggle_config`, et un autre module peut l'appeler. Retirer un bouton
                 n'est pas retirer une API. -->
            <xpath
                expr="//label[@for='purchase_ok' or @for='sale_ok']"
                position="after"
            >
                <div class="oe_left" name="options" groups="base.group_user">
                    <field name="id" invisible="True" />
                </div>
            </xpath>

            <!-- Product attributes -->
            <xpath expr="//field[@name='attribute_line_ids']" position="attributes">
                <attribute
                    name="context"
                >{'default_config_ok': context.get('default_config_ok', False)}</attribute>
            </xpath>

            <!-- TODO: Implement a method to hide this field for non-configurable product templates -->
            <xpath
                expr="//field[@name='attribute_line_ids']/list/field[@name='value_ids']"
                position="after"
            >
                <!-- ══ L'ÉTAPE SE RÈGLE ICI, SUR LA LIGNE QUI L'OUVRE — B1, D-202 ══
                     Arbitrage : l'étape est un SÉPARATEUR, et « ce qui suit lui
                     appartient jusqu'au suivant ». Poser une étape sur une ligne, ce
                     n'est donc pas dire « j'en fais partie » mais « j'en OUVRE une ».

                     ⚠️ L'ORDRE DEVIENT UNE DONNÉE PORTEUSE : glisser une ligne change
                     son étape. D'où la colonne « Étape », en lecture, juste à côté —
                     elle montre l'effet à distance au lieu de le laisser deviner. -->
                <field
                    name="config_step_id"
                    column_invisible="not context.get('default_config_ok', False)"
                    options="{'no_create_edit': True}"
                />
                <field
                    name="config_step_owner_id"
                    column_invisible="not context.get('default_config_ok', False)"
                    readonly="1"
                    optional="show"
                />
                <!-- ══ LES VALEURS S'OUVRENT DANS UN DIALOGUE — B5, D-206 ═══════
                     « Une ligne qui au clic ouvre la liste des valeurs », « dans un
                     dialogue ». Le bouton est TOUJOURS là — c'est le seul endroit
                     d'où l'on voit les prix, l'effet du retrait et les valeurs
                     désactivées. Les pastilles, elles, s'effacent quand elles
                     cessent d'être lisibles. -->
                <field name="value_count" column_invisible="False" optional="hide" />
                <field name="too_many_values" column_invisible="True" />
                <button
                    name="action_open_values"
                    type="object"
                    string="Values"
                    icon="fa-list-ul"
                    class="btn-link"
                    column_invisible="not context.get('default_config_ok', False)"
                />

                <!-- ══ LA CONDITION SE LIT À CÔTÉ DE CE QU'ELLE RESTREINT — B3 ══
                     C'est tout le gain de l'unification : une restriction cesse
                     d'être une ligne dans une autre table. Le champ existait sur la
                     ligne d'attribut et ne se voyait que dans son formulaire.

                     ⓘ Même widget qu'ailleurs (B2, D-203) : il LIT la condition en
                     pastilles ; l'édition reste le formulaire de condition. -->
                <field
                    name="visibility_domain_summary"
                    column_invisible="True"
                />
                <field
                    name="visibility_domain_id"
                    widget="condition_facets"
                    options="{'summary_field': 'visibility_domain_summary'}"
                    context="{'product_tmpl_id': parent.id, 'form_view_ref': 'product_configurator_fa.product_config_domain_form_view_template'}"
                    column_invisible="not context.get('default_config_ok', False)"
                    optional="show"
                />
                <field
                    name="default_val"
                    domain="[('id', 'in', value_ids)]"
                    context="{'show_attribute': False}"
                    options="{'no_create': True, 'no_create_edit': True}"
                    column_invisible="not context.get('default_config_ok', False)"
                />
                <field
                    name="required"
                    column_invisible="not context.get('default_config_ok', False)"
                />
                <field
                    name="required_condition"
                    column_invisible="not context.get('default_config_ok', False)"
                    optional="hide"
                    groups="base.group_no_one"
                />
                <field
                    name="readonly_condition"
                    column_invisible="not context.get('default_config_ok', False)"
                    optional="hide"
                    groups="base.group_no_one"
                />
                <field
                    name="invisible_condition"
                    column_invisible="not context.get('default_config_ok', False)"
                    optional="hide"
                    groups="base.group_no_one"
                />
                <field
                    name="multi"
                    column_invisible="not context.get('default_config_ok', False)"
                    readonly="custom"
                    force_save="1"
                />
                <field
                    name="custom"
                    column_invisible="not context.get('default_config_ok', False)"
                    readonly="multi"
                    force_save="1"
                />
            </xpath>

            <xpath
                expr="//field[@name='attribute_line_ids']/list/field[@name='value_ids']"
                position="attributes"
            >
                <!-- ⚠️ PAR LIGNE et non par colonne : le seuil dépend du nombre de
                     valeurs de CETTE ligne, et `column_invisible` ne s'évalue que
                     sur le contexte parent. Une liste peut mêler un attribut à
                     trois valeurs et un autre à trois cents. -->
                <attribute name="invisible">too_many_values</attribute>
                <attribute name="required">not custom</attribute>
            </xpath>


            <!-- TODO: Apply domains so only values from template are available -->
            <xpath expr="//notebook/page[@name='variants']" position="after">
                <page
                    string="Configurator"
                    name="configurator"
                    invisible="not config_ok"
                    groups="product_configurator_fa.group_product_configurator_fa"
                >
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not price_grid_warning"
                    >
                        <field name="price_grid_warning" nolabel="1" readonly="1" />
                    </div>
                    <separator colspan="4" string="Price Grid" name="price_grid" />
                    <field name="price_grid_ids" nolabel="1">
                        <list>
                            <field name="name" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="currency_id" />
                        </list>
                    </field>
                    <separator
                        colspan="4"
                        string="Configuration Restrictions"
                        name="configurator_restrictions"
                    />
                    <field
                        name="config_line_ids"
                        readonly="not attribute_line_ids"
                        context="{'show_attribute': False}"
                    >
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field
                                name="attribute_line_id"
                                domain="[('product_tmpl_id','=',parent.id)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <!-- # TODO: Find a more elegant way to restrict the value_ids -->
                            <field
                                name="attr_line_val_ids"
                                widget="many2many_tags"
                                column_invisible="1"
                            />
                            <field
                                name="value_ids"
                                widget="many2many_tags"
                                readonly="not attribute_line_id"
                                domain="[('id','in',attr_line_val_ids)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                                context="{'show_attribute': False}"
                            />
                            <!-- ⚠️ LA CONDITION SE LIT EN PASTILLES — B2, D-203.
                                 « ET entre les pastilles, OU à l'intérieur d'une. »
                                 Le widget LIT seulement : l'édition reste le
                                 formulaire de condition, qui manipule des
                                 enregistrements (D-080). -->
                            <field name="domain_summary" column_invisible="True" />
                            <field
                                name="domain_id"
                                widget="condition_facets"
                                options="{'summary_field': 'domain_summary'}"
                                context="{'product_tmpl_id': product_tmpl_id or id or parent.id, 'product_attribute_ids': template_attribute_ids, 'form_view_ref': 'product_configurator_fa.product_config_domain_form_view_template'}"
                            />
                            <field name="product_tmpl_id" column_invisible="1" />
                            <field name="template_attribute_ids" column_invisible="1" />
                        </list>
                    </field>
                    <separator
                        colspan="4"
                        string="Configuration Steps"
                        name="configurator_steps"
                    />
                    <field
                        name="config_step_line_ids"
                        readonly="not attribute_line_ids"
                    >
                        <!-- ⚠️ CETTE LISTE NE SE SAISIT PLUS QU'À MOITIÉ — B1, D-202.
                             L'étape est devenue un SÉPARATEUR : son rang et ses
                             attributs se lisent dans l'ordre des lignes d'attribut,
                             et se règlent LÀ-BAS, par la colonne « Ouvre l'étape ».
                             Ici ne restent que les réglages propres à l'étape.

                             ⓘ `attribute_line_ids` reste affiché, en lecture : c'est
                             ce qui rend visible l'effet à distance du glisser-déposer.
                             Le retirer aurait laissé l'utilisateur deviner ce qu'une
                             étape contient. -->
                        <list editable="bottom" create="false">
                            <field name="sequence" column_invisible="True" />
                            <field name="config_step_id" readonly="1" />
                            <field
                                name="attribute_line_ids"
                                widget="many2many_tags"
                                readonly="1"
                            />
                            <field
                                name="required"
                                readonly="1"
                                widget="boolean_toggle"
                            />
                            <field name="visibility_domain_summary" column_invisible="True" />
                            <field
                                name="visibility_domain_id"
                                widget="condition_facets"
                                options="{'summary_field': 'visibility_domain_summary'}"
                                context="{'product_tmpl_id': parent.id, 'form_view_ref': 'product_configurator_fa.product_config_domain_form_view_template'}"
                            />
                        </list>
                    </field>
                    <separator
                        colspan="4"
                        string="Configuration Images"
                        name="configurator_images"
                    />
                    <field name="config_image_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field
                                name="value_ids"
                                widget="many2many_tags"
                                context="{'_cfg_product_tmpl_id': parent.id}"
                            />
                            <field
                                name="image_1920"
                                widget="image"
                                class="oe_prod_config_image"
                            />
                        </list>
                    </field>
                    <field name="attribute_line_val_ids" invisible="1" />
                    <field name="attribute_value_line_ids" invisible="1">
                        <list
                            editable="bottom"
                            context="{'default_product_tmpl_id': self.id}"
                        >
                            <field name="product_tmpl_id" invisible="1" />
                            <field name="attribute_id" invisible="1" />
                            <field name="sequence" widget="handle" />
                            <field
                                name="value_id"
                                domain="[('id', 'in', parent.attribute_line_val_ids)]"
                            />
                            <field
                                name="value_ids"
                                domain="[
                                ('id', 'in', parent.attribute_line_val_ids),
                                ('attribute_id', '!=', attribute_id)
                               ]"
                                widget="many2many_tags"
                            />
                        </list>
                    </field>
                    <separator
                        string="Variant Name"
                        colspan="4"
                        groups="product_configurator_fa.group_product_configurator_fa_manager"
                    />
                    <field
                        name="mako_tmpl_name"
                        groups="product_configurator_fa.group_product_configurator_fa_manager"
                    />
                </page>
            </xpath>

            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="invisible">config_ok</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.configurator.product.template.search.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <separator />
                <filter
                    string="Standard Products"
                    name="filter_standard_products"
                    domain="[('config_ok','=',False)]"
                />
                <filter
                    string="Configurable Products"
                    name="filter_config_ok"
                    domain="[('config_ok','=',True)]"
                />
            </xpath>
        </field>
    </record>

    <record id="template_view_tree_configurable" model="ir.ui.view">
        <field name="name">product.template.product.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute
                    name="invisible"
                >context.get('default_config_ok', 0)</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view_inherited" model="ir.ui.view">
        <field name="name">Product.template.product.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="config_ok" />
            </xpath>
            <xpath expr="//field[@name='is_favorite']" position="before">
                <div
                    class="float-end"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    invisible="not config_ok"
                >
                    <a name="configure_product" type="object">
                        <i class="fa fa-wrench fa-lg" title="Configure Product" />
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_form_view_custom_vals_inherit" model="ir.ui.view">
        <field name="name">product.configurator.form.view.custom.vals</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr='//header' position="inside">
                <button
                    name="reconfigure_product"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    class="oe_highlight"
                    type="object"
                    string="Reconfigure Product"
                    invisible="not config_ok"
                />
            </xpath>
            <!-- <xpath expr="//button[@name='toggle_config']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            <xpath expr="//div[@name='options']" position="inside">
                <field name="config_preset_ok" invisible="not config_ok" />
                <label for="config_preset_ok" invisible="not config_ok" />
            </xpath>
        </field>
    </record>

    <record id="product_variant_easy_edit_view_inherit" model="ir.ui.view">
        <field name="name">product.product.view.form.easy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="config_ok" invisible="1" />
                <field name="config_preset_ok" invisible="not config_ok" />
            </xpath>
            <xpath expr="//field[@name='weight']" position="attributes">
                <attribute name="readonly">config_ok</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_kanban_view_inherited" model="ir.ui.view">
        <field name="name">Product Kanban</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="config_ok" />
            </xpath>
            <xpath expr="//field[@name='is_favorite']" position="before">
                <div
                    class="float-end"
                    groups="product_configurator_fa.group_product_configurator_fa"
                    invisible="not config_ok"
                >
                    <a
                        name="reconfigure_product"
                        type="object"
                        class="fa fa-repeat fa-lg"
                        title="Reconfigure Product"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
